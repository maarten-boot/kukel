# Tests of todo.kkl, run in examples/ (see examples/README.md), with a
# database in memory: nothing is left behind. The tasks' keys are UUIDs,
# different in each run: the tests show the numbers only.

$ -db sqlite::memory: < testdata/todo.txt
added 1
added 2
added 3
3 [ ] call Ann  (due 2026-10-18)
1 [ ] write the report  (due 2026-10-20)  #work
2 [ ] buy milk  #home #shop
done 3
tagged 3
tagged 1
3 [x] call Ann  (due 2026-10-18)  #home
1 [ ] write the report  (due 2026-10-20)  #urgent #work
2 [ ] buy milk  #home #shop
3 [x] call Ann  (due 2026-10-18)  #home
2 [ ] buy milk  #home #shop
1 [ ] write the report  (due 2026-10-20)  #urgent #work
removed 2
3 [x] call Ann  (due 2026-10-18)  #home
[
  {
    "num": 1,
    "title": "write the report",
    "due": "2026-10-20",
    "done": false,
    "tags": [
      "urgent",
      "work"
    ]
  },
  {
    "num": 3,
    "title": "call Ann",
    "due": "2026-10-18",
    "done": true,
    "tags": [
      "home"
    ]
  }
]
! todo: done: there is no task 9
! todo: done: there is no task 0190a6b0-0000-7000-8000-000000000000
! todo: add: a task needs a title
! todo: add: -tag needs a name
! todo: tag: give the task's number and tags
exit 1

$ -db sqlite::memory: list

$ -db sqlite::memory: add pay rent -tag home due 2026-11-01
added 1

$ -db sqlite::memory: done two
! todo: done: int: "two" is not an integer
exit 1

$ -db sqlite::memory: list soon
! todo: list: list open, done or all, not soon
exit 1

$ -db sqlite::memory: fly
! todo: unknown command fly
! usage: todo [-db url] [add title [due yyyy-mm-dd] [-tag t] | done N | rm N | tag N t ... | list [open|done|all] [-tag t] | export]
exit 2

$ -db nope:x list
! todo: db::open: "nope:x" is not a database URL: use "sqlite:file.db", "sqlite::memory:", "postgres://user:password@host/database" or "mysql://user:password@host/database"
exit 2

$ -db
