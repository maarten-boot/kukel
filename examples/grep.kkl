// grep: prints the lines of files (or of standard input) that match a
// regular expression (module re, Go's RE2 syntax).
//
//     kukel run examples/grep.kkl -- [options] pattern [file ...]
//
//     -i  ignore case            -v  the lines that do not match
//     -n  line numbers           -c  only how many lines match, per file
//     -l  only the names of the files with a match
//     -o  only the matching parts of the lines
//     -F  the pattern is plain text, not a regular expression
//     -h  no file names before the lines (the default for one file)
//     -r  search the files in the directories given (none: the current one),
//         and below them (module fs)
//
// The exit code is 0 when a line matched, 1 when none did, 2 after an error.
use re;
use fs;

// The options, by letter: true when given.
global opts = {};

// Whether a file or directory could not be read (exit code 2).
global failed = false;

usage(why) {
    eprintln("grep:", why);
    eprintln("usage: grep [-icFhlnorv] pattern [file ...]");
    return 2;
}

main(args) {
    local i = 0;

    for (; i < len(args) && len(args[i]) > 1 && args[i][0] == '-'; i++) {
        if (args[i] == "--") {
            i++;
            break;
        }

        for (local c in slice(args[i], 1)) {
            if (find("icFhlnorv", char(c)) < 0) return usage("unknown option -" + char(c));
            opts[char(c)] = true;
        }
    }

    if (i == len(args)) return usage("no pattern");
    local pattern = args[i];

    if (haskey(opts, "F")) pattern = re::quote(pattern);
    local rx;

    try {
        rx = re::compile(pattern, haskey(opts, "i") ? "i" : "");
    } catch (e) {
        return usage("bad pattern: " + e->message);
    }

    local files = slice(args, i + 1), found = false;

    if (haskey(opts, "r")) files = below(len(files) == 0 ? ["."] : files);

    if (len(files) == 0) {
        found = search(rx, "(standard input)", stdinLines(), false);
    } else {
        for (local f in files) {
            try {
                local text = readfile(f);

                if (search(rx, f, lines(text), len(files) > 1 && !haskey(opts, "h"))) found = true;
            } catch (e) {
                eprintln("grep:", e->message);
                failed = true;
            }
        }
    }
    return failed ? 2 : found ? 0 : 1;
}

// search prints what the options ask for about the lines of one file, and
// tells whether a line matched.
search(rx, name, lines, showName) {
    local count = 0, prefix = showName ? name + ":" : "";

    for (local i = 0; i < len(lines); i++) {
        local line = lines[i];

        if (rx->match(line) == haskey(opts, "v")) continue;
        count++;

        if (haskey(opts, "l")) break;

        if (haskey(opts, "c")) continue;
        local at = prefix + (haskey(opts, "n") ? str(i + 1) + ":" : "");

        if (haskey(opts, "o")) { // with -v: nothing (no matching parts)
            for (local m in haskey(opts, "v") ? [] : rx->findall(line))
                if (m != "") println(at + m); // as GNU grep: no empty matches
        } else {
            println(at + line);
        }
    }

    if (haskey(opts, "l")) { // -l wins over -c
        if (count > 0) println(name);
    } else if (haskey(opts, "c")) {
        println(prefix + str(count));
    }
    return count > 0;
}

// lines splits the text of a file into its lines (a last newline ends the
// last line, it does not start an empty one).
lines(text) {
    local v = split(text, "\n");

    if (len(v) > 0 && v[len(v) - 1] == "") pop(v);
    return v;
}

stdinLines() {
    local v = [];

    for (local line = readline(); line != nil; line = readline()) push(v, line);
    return v;
}

// below gives the files in the directories of paths, and below them, in
// the order walk finds them (by name); other paths stay as they are. A
// directory that cannot be read is reported, and the others are searched.
below(paths) {
    local out = [];

    for (local p in paths) {
        try {
            if (fs::exists(p) && fs::stat(p)["dir"]) {
                fs::walk(p, fn(path, e) {
                    if (!e["dir"] && !e["link"]) push(out, path);
                });
            } else {
                push(out, p);
            }
        } catch (e) {
            eprintln("grep:", e->message);
            failed = true;
        }
    }
    return out;
}
