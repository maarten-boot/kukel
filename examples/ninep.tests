# Tests of ninep.kkl, run in examples/ (see examples/README.md). demo serves
# the tree on a free port and reads it with its own client; a server and a
# client in two processes cannot be run from here.

$ demo
-- 9P2000
-rw-rw-rw- 0 ctl
dr-xr-xr-x 0 empty/
dr-xr-xr-x 0 files/
-r--r--r-- 18 hello
-r--r--r-- 0 hits
-rw-rw-rw- 0 notes
-r--r--r-- 0 time
Hello from Kukel.
hits: 1
written with 9P2000
p9::Client::write: /hello: permission denied: the file cannot be written
-r--r--r-- 49 util.kkl
no matches here
p9::Client::remove: /files/notes.txt: read-only file system
p9::Client::write: /ctl: unknown command: halt
-- 9P2000.L
-rw-rw-rw- 0 ctl
dr-xr-xr-x 0 empty/
dr-xr-xr-x 0 files/
-r--r--r-- 18 hello
-r--r--r-- 0 hits
-rw-rw-rw- 0 notes
-r--r--r-- 0 time
Hello from Kukel.
hits: 2
written with 9P2000
written with 9P2000.L
p9::Client::write: /hello: permission denied
-r--r--r-- 49 util.kkl
no matches here
p9::Client::remove: /files/notes.txt: read-only file system
p9::Client::write: /ctl: input/output error
stopped: true

$ cat tcp://localhost:5640
! ninep: wrong number of arguments for cat
! usage: ninep serve address [directory] | ls address [path] | cat address path | put address path text | demo [directory]
exit 2

$ serve
! ninep: wrong number of arguments for serve
! usage: ninep serve address [directory] | ls address [path] | cat address path | put address path text | demo [directory]
exit 2

$ demo testdata/tree extra
! ninep: wrong number of arguments for demo
! usage: ninep serve address [directory] | ls address [path] | cat address path | put address path text | demo [directory]
exit 2

$ rm tcp://localhost:5640 /hello
! ninep: unknown command rm
! usage: ninep serve address [directory] | ls address [path] | cat address path | put address path text | demo [directory]
exit 2

$ ls localhost:5640
! ninep: p9::dial: "localhost:5640" is not a 9P address such as "tcp://host:564" or "unix:///path"
exit 2

$ serve tcp://127.0.0.1:0 testdata/nope
! ninep: p9::disk: testdata/nope: no such file or directory
exit 2

$ demo testdata/nope
! ninep: p9::disk: testdata/nope: no such file or directory
exit 2
