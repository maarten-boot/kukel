// lmwgui.kkl: a GUI for LMW-Synth over 9P (docs/future.md §13), with the
// module tk (a kukel built with the build tag tk, and a display):
//
//     kukel run lmwgui.kkl [-- [-a address | -fake] [-config file] [-tab name] [-v]]
//
// -a address: the synth (as lmwctl takes it); without it, the newest synth
// socket that answers. -fake: a fake synth in this program (fakesynth.kkl).
// -config file: the settings file instead of lmw-gui.toml in the user's
// configuration directory. -tab name: the tab shown first (Synth, Effects,
// Matrix or Notes). -v: prints what it shows and writes, for the tests.
//
// The Synth tab has the synth's module panels, the Effects tab the reverb.
// A fader writes its parameter at most every 20 ms while it moves; every
// 200 ms the GUI asks the synth what changed and shows it, except on a
// fader the user holds (until half a second after it is let go). A value
// can be typed under a fader (Enter); a double click on a fader resets it.
// The Matrix tab has a row per input and a column per output: a click
// puts a cable in or takes it out, dragging up or down sets its level, a
// double click asks for it; the arrow keys move a cell cursor, Space
// toggles, + and - change by 10 %, Delete removes. The Notes tab is the
// patch's notes, written a second after typing stops and when the text
// loses the keyboard.
//
// Load and Save (Ctrl+O, Ctrl+S) read a patch file into the synth and
// write the synth's patch to a file; Ctrl+Q quits. The list in the header
// has the synths that are running (their sockets), to switch to another.
// The contrast (AA, AAA, Max or a custom ratio) is kept in the settings
// file.
use tk;
use events;
use lmw;
use lmwtheme;
use fakesynth;
use toml;
use fs;

// The panels in the synth's rows (its Spec S6.1): a title and the controls,
// each [id, label]; a vector of two of them is a column of two choices.
global SYNTH = [
    [
        ["VCO 1", [["vco1.fm", "FM"], ["vco1.tune", "Tune"], [["vco1.wave", "Wave"], ["vco1.octave", "Oct"]]]],
        ["VCO 2", [["vco2.fm", "FM"], ["vco2.tune", "Tune"], [["vco2.wave", "Wave"], ["vco2.octave", "Oct"]]]],
        ["VCO 3", [["vco3.fm", "FM"], ["vco3.tune", "Tune"], [["vco3.wave", "Wave"], ["vco3.octave", "Oct"]]]],
        ["NOISE", [["noise.colour", "Colour"], ["noise.rate", "Rate"], ["noise.smooth", "Smooth"]]],
        ["LFO 1", [["lfo1.wave", "Wave"], ["lfo1.rate", "Rate"]]],
    ],
    [
        ["MIXER", [["mix.vco1", "VCO 1"], ["mix.vco2", "VCO 2"], ["mix.vco3", "VCO 3"], ["mix.noise", "Noise"]]],
        [
            "VCF 1",
            [
                ["vcf1.cutoff", "Cutoff"], ["vcf1.res", "Reso"], ["vcf1.env", "Env 2"], ["vcf1.key", "Key"],
                [["vcf1.slope", "Slope"], ["vcf1.type", "Type"]],
            ],
        ],
        [
            "VCF 2",
            [
                ["vcf2.cutoff", "Cutoff"], ["vcf2.res", "Reso"], ["vcf2.env", "Env 2"], ["vcf2.key", "Key"],
                [["vcf2.slope", "Slope"], ["vcf2.type", "Type"]],
            ],
        ],
    ],
    [
        ["KEYS", [["voice.count", "Voices"]]],
        ["ENV 1 → VCA", [["env1.attack", "Attack"], ["env1.decay", "Decay"], ["env1.sustain", "Sustain"], ["env1.release", "Release"]]],
        ["ENV 2 → VCF", [["env2.attack", "Attack"], ["env2.decay", "Decay"], ["env2.sustain", "Sustain"], ["env2.release", "Release"]]],
        ["LFO 2", [["lfo2.wave", "Wave"], ["lfo2.rate", "Rate"]]],
        ["VCA", [["vca.initial", "Initial"], ["vca.tremolo", "Tremolo"]]],
        ["OUT", [["out.gain", "Volume"]]],
    ],
];
global EFFECTS = [[["REVERB", [["reverb.mix", "Mix"], ["reverb.size", "Size"], ["reverb.damping", "Damping"], ["reverb.width", "Width"]]]]];

const STEPS = 1000;      // a fader's positions
const THROTTLE = 0.02;   // seconds between the writes of a moving fader
const POLL = 0.2;        // seconds between the questions to the synth
const SETTLE = 0.5;      // seconds a fader is left alone after the user

global window, synth, address, server = nil, verbose = false;
global status, patchname, reconnect, contrast, customratio;
global controls = {};    // id -> {"p", "kind", "scale", "entry", "box"}
global titles = [];      // [label, unit kind] of each panel title
global held = {}, touched = {}, latest = {}, stale = {};
global pending = {}, flushing = nil, poller = nil, shown = false;
global configpath, preset = "AA", ratio = 4.5;
global geometry = [], placed = {}, placing = false;   // -v: where the faders are
global tabs, theme = nil;
global matrix = nil, inputs = [], outputs = [], normalled = {}, cables = {};
global cursor = [0, 0], focused = false, drag = nil;
global notesbox = nil, notestext = "", notesdirty = false, notestimer = nil;
global synthlist, lister = nil, patchtitle = "", synths = {};   // label -> address
global loadbutton, savebutton, connected = true;

// The matrix's sizes in pixels: the labels of the rows, the heads of the
// columns, a cell.
const LABELW = 150;
const HEADH = 38;
const CELLW = 46;
const CELLH = 26;

main(args) {
    local fake = false, i = 0, first = "Synth";
    configpath = nil;

    for (; i < len(args); i++) {
        if (args[i] == "-a" && i + 1 < len(args)) {
            address = args[++i];
        } else if (args[i] == "-fake") {
            fake = true;
        } else if (args[i] == "-config" && i + 1 < len(args)) {
            configpath = args[++i];
        } else if (args[i] == "-tab" && i + 1 < len(args)) {
            first = args[++i];
        } else if (args[i] == "-v") {
            verbose = true;
        } else {
            eprintln("usage: lmwgui [-a address | -fake] [-config file] [-tab Synth|Effects|Matrix|Notes] [-v]");
            return 2;
        }
    }

    try {
        if (fake) {
            server = new fakesynth::Synth()->serve("tcp://127.0.0.1:0");
            address = server->endpoint();
        }
        synth = lmw::connect(address);
        address = synth->address;

        if (synth->info() == nil) {
            throw new Error("this synth has no /info (it describes the parameters): a newer synth is needed");
        }
    } catch (e) {
        eprintln("lmwgui:", e->message);

        if (server != nil) {
            server->close();
        }
        return 1;
    }
    readconfig();

    try {
        build(first);
    } catch (e) {
        eprintln("lmwgui:", e->message);
        quit();

        if (window != nil) {
            window->close();
        }
        return 1;
    }
    trace("connected", address);
    setcontrast(preset, ratio, false);
    poll();
    poller = events::every(POLL, poll);
    listsynths();
    lister = events::every(2, listsynths);
    events::run();
    return 0;
}

// trace(words...): a line for -v (the tests read it at once).
trace(words..) {
    if (verbose) {
        println(words..);
        fs::stdout()->flush();
    }
}

// extend(v, x...): a new vector of v's elements and then x.
extend(v, more..) {
    local out = [];

    for (local x in v) {
        push(out, x);
    }

    for (local x in more) {
        push(out, x);
    }
    return out;
}

// cell(w): for -v, w's place in its parent, kept up to date: a map with
// x, y, w and h once Tk placed it.
cell(w) {
    local c = {};

    if (verbose) {
        w->bind("<Configure>", fn(e) {
            c["x"] = e["x"];
            c["y"] = e["y"];
            c["w"] = e["width"];
            c["h"] = e["height"];

            if (!placing) {
                placing = true;
                events::post(places);
            }
        });
    }
    return c;
}

// places(): for -v, "at id x y w h" for each fader that moved: its place
// in the window.
places() {
    placing = false;

    for (local g in geometry) {
        local x = 0, y = 0, last = nil;

        for (local c in g[1]) {
            if (c["x"] == nil) {
                last = nil;
                break;
            }
            x += c["x"];
            y += c["y"];
            last = c;
        }

        if (last != nil) {
            local s = join([x, y, last["w"], last["h"]], " ");

            if (placed[g[0]] != s) {
                placed[g[0]] = s;
                trace("at", g[0], s);
            }
        }
    }
}

say(text) {
    status->settext(text);
}

// The window

build(first) {
    window = new tk::Window("LMW-Synth: " + address);
    window->onclose(quit);
    local head = new tk::Frame(window, {"padding": [6, 4]});
    head->pack({"fill": "x"});
    local headcell = cell(head);   // one: a second bind would replace the first

    // From the left: the synth (first: the window may be wider than the
    // screen), the patch, the contrast.
    new tk::Label(head, "Synth:")->pack({"side": "left"});
    synthlist = new tk::Combobox(head, [label(address)], {"state": "readonly", "width": 16});
    synthlist->settext(label(address));
    synthlist->onselect(fn(l) {
        local a = synths[l] == nil ? l : synths[l];

        if (a != address) {
            switchto(a);
        }
    });
    synthlist->pack({"side": "left", "padx": 4});

    if (verbose) {
        push(geometry, ["synthlist", [headcell, cell(synthlist)]]);
    }
    reconnect = new tk::Button(head, "Connect again", {"state": "disabled"});
    reconnect->onclick(connectagain);
    reconnect->pack({"side": "left"});

    if (verbose) {
        push(geometry, ["reconnect", [headcell, cell(reconnect)]]);
    }
    patchname = new tk::Label(head, "Patch:", {"width": 24});
    patchname->pack({"side": "left", "padx": 12});
    loadbutton = new tk::Button(head, "Load...");
    loadbutton->onclick(loadpatch);
    loadbutton->pack({"side": "left"});
    savebutton = new tk::Button(head, "Save...");
    savebutton->onclick(savepatch);
    savebutton->pack({"side": "left", "padx": 4});
    new tk::Label(head, "Contrast:")->pack({"side": "left", "padx": 4});
    contrast = new tk::Combobox(head, ["AA", "AAA", "Max", "Custom"], {"state": "readonly", "width": 7});
    contrast->pack({"side": "left"});
    customratio = new tk::Entry(head, {"width": 5});
    customratio->pack({"side": "left", "padx": 4});
    contrast->onselect(fn(p) { setcontrast(p, customratio->text(), true); });
    customratio->onenter(fn(text) { setcontrast("Custom", text, true); });

    tabs = new tk::Notebook(window, {"padding": 4});
    tabs->pack({"fill": "both", "expand": true});
    local page = new tk::Frame(tabs, {"padding": 4}), effects = new tk::Frame(tabs, {"padding": 4});
    local cablepage = new tk::Frame(tabs, {"padding": 4}), notespage = new tk::Frame(tabs, {"padding": 4});
    tabs->add(page, "Synth")->add(effects, "Effects")->add(cablepage, "Matrix")->add(notespage, "Notes");
    local top = [cell(tabs)];
    rows(page, SYNTH, extend(top, cell(page)));
    rows(effects, EFFECTS, extend(top, cell(effects)));
    makematrix(cablepage, extend(top, cell(cablepage)));
    makenotes(notespage, extend(top, cell(notespage)));
    status = new tk::Label(window, "", {"anchor": "w", "padding": [6, 2]});
    status->pack({"fill": "x"});
    local names = ["Synth", "Effects", "Matrix", "Notes"], found = false;

    for (local i = 0; i < len(names); i++) {
        if (lower(first) == lower(names[i])) {
            tabs->select(i);
            found = true;
        }
    }

    if (!found) {
        throw new Error("there is no tab " + first + " (Synth, Effects, Matrix or Notes)");
    }

    // The keys of the window; on the notes too, where Tk's text would
    // otherwise take Ctrl+O as a new line.
    for (local k, f in {"o": loadpatch, "s": savepatch, "q": fn() {
        quit();
        window->close();
    }}) {
        local shortcut = fn(e) {
            f();
            return false;
        };
        window->bind("<Control-Key-" + k + ">", shortcut);
        notesbox->bind("<Control-Key-" + k + ">", shortcut);
    }
    tabs->onchange(fn(i) {
        if (i == 2) {
            matrix->focus();
        }
    });

    if (tabs->selected() == 2) {
        matrix->focus();
    }
}

// rows(page, layout, chain): the panels of layout in page; chain is where
// page is (for -v).
rows(page, layout, chain) {
    for (local row in layout) {
        local f = new tk::Frame(page);
        f->pack({"fill": "x"});
        local at = extend(chain, cell(f));   // one cell: a second bind would replace the first

        for (local panel in row) {
            makepanel(f, panel[0], panel[1], at);
        }
    }
}

// makepanel(parent, title, items, chain): a module panel: its title in the
// unit's colour, and a column per control.
makepanel(parent, title, items, chain) {
    local f = new tk::Frame(parent, {"relief": "solid", "borderwidth": 1});
    f->pack({"side": "left", "fill": "y", "padx": 3, "pady": 3});
    local t = new tk::Label(f, title, {"anchor": "center", "padding": [6, 2], "font": {"bold": true}});
    t->pack({"fill": "x"});
    push(titles, [t, lmwtheme::unit(title)]);
    local body = new tk::Frame(f, {"padding": 4}), column = 0;
    body->pack({"fill": "both", "expand": true});
    chain = extend(chain, cell(f), cell(body));

    for (local item in items) {
        local c = new tk::Frame(body);
        c->grid({"row": 0, "column": column++, "sticky": "n", "padx": 3});
        local at = extend(chain, cell(c));

        if (typeof(item[0]) == "vector") {
            for (local sub in item) {
                control(c, sub[0], sub[1], at);
            }
        } else {
            control(c, item[0], item[1], at);
        }
    }
}

// control(parent, id, label, chain): a fader with its value under it, or
// for a choice a drop-down list.
control(parent, id, label, chain) {
    local p = synth->param(id);
    new tk::Label(parent, label, {"anchor": "center"})->pack({"fill": "x"});

    if (p == nil) {   // the synth has no such parameter
        new tk::Label(parent, "(none)")->pack();
        return;
    }

    if (p["kind"] == "choice") {
        local width = 3;

        for (local name in p["choices"]) {
            width = max(width, len(name) + 1);
        }
        local box = new tk::Combobox(parent, p["choices"], {"state": "readonly", "width": width});
        box->pack({"pady": 2});
        box->onselect(fn(text) { setnow(id, text); });
        controls[id] = {"p": p, "kind": "choice", "box": box};
        return;
    }
    local scale = new tk::Scale(parent, {"from": STEPS, "to": 0, "step": 1, "orient": "vertical", "length": 120});
    scale->pack();
    local entry = new tk::Entry(parent, {"width": 9, "justify": "center"});
    entry->pack({"pady": 2});
    controls[id] = {"p": p, "kind": "fader", "scale": scale, "entry": entry};

    if (verbose) {
        push(geometry, [id, extend(chain, cell(scale))]);
    }
    scale->onchange(fn(pos) { moved(id, pos); });
    scale->bind("<Button-1>", fn(e) { held[id] = true; });
    scale->bind("<ButtonRelease-1>", fn(e) {
        held[id] = false;
        touched[id] = clock() + SETTLE;
    });
    scale->bind("<Double-Button-1>", fn(e) { setnow(id, p["default"]); });
    entry->onenter(fn(text) {
        local v = parsetext(p, text);

        if (v == nil) {
            say(id + ": not a value: " + text);
            show(id, latest[id]);
        } else {
            setnow(id, v);
        }
    });
}

// Faders: positions, values and their text (as the synth's ParamText.h)

// _skew(p): the skew of a fader whose middle is p["centre"] (JUCE's
// setSkewForCentre); 1 for a linear one.
_skew(p) {
    if (p["centre"] == nil) {
        return 1.0;
    }
    return log(0.5) / log((p["centre"] - p["min"]) / (p["max"] - p["min"]));
}

// position(p, v): the fader position (0 to STEPS) of value v.
position(p, v) {
    local x = (float(v) - p["min"]) / (p["max"] - p["min"]);
    x = max(0.0, min(1.0, x));
    return round(pow(x, _skew(p)) * STEPS);
}

// valueat(p, pos): the value at fader position pos, on the step.
valueat(p, pos) {
    local x = float(pos) / STEPS;

    if (x > 0) {
        x = exp(log(x) / _skew(p));
    }
    local v = p["min"] + (p["max"] - p["min"]) * x;

    if (p["kind"] == "int") {
        return round(v);
    }

    if (p["step"] != nil) {
        v = round(v / p["step"]) * p["step"];
    }
    return v;
}

// fixed(x, d): x with d decimals.
fixed(x, d) {
    local n = round(x * pow(10, d)), neg = n < 0;

    if (neg) {
        n = -n;
    }
    local s = str(n);

    if (d > 0) {
        while (len(s) <= d) {
            s = "0" + s;
        }
        s = slice(s, 0, len(s) - d) + "." + slice(s, len(s) - d);
    }
    return (neg ? "-" : "") + s;
}

// text(p, v): the value as the synth shows it under a fader.
text(p, v) {
    if (p["kind"] != "float") {
        return str(v);
    }
    local u = p["unit"];

    if (u == "s") {
        return v < 0.9995 ? fixed(v * 1000, 0) + " ms" : v < 9.995 ? fixed(v, 2) + " s" : fixed(v, 1) + " s";
    } else if (u == "%") {
        return fixed(v * 100, 0) + " %";
    } else if (u == "dB") {
        if (v <= 0) {
            return "-inf dB";
        }
        local db = 20 * log(v) / log(10);
        return fixed(abs(db) < 0.05 ? 0.0 : db, 1) + " dB";
    } else if (u == "Hz") {
        return v < 10 ? fixed(v, 2) + " Hz" : v < 100 ? fixed(v, 1) + " Hz" : v < 999.5 ? fixed(v, 0) + " Hz"
            : v < 9995 ? fixed(v / 1000, 2) + " kHz" : fixed(v / 1000, 1) + " kHz";
    } else if (u == "oct") {
        return abs(v) < 0.05 ? "0.0 oct" : (v > 0 ? "+" : "") + fixed(v, 1) + " oct";
    } else if (u == "st") {
        return fixed(v, 1) + " st";
    }
    return fixed(v, 2);
}

// _number(s): the number at the start of s, or nil.
_number(s) {
    local end = 0, chars = "+-.0123456789eE";

    while (end < len(s) && find(chars, slice(s, end, end + 1)) >= 0) {
        end++;
    }

    try {
        return float(slice(s, 0, end));
    } catch (e) {
        return nil;
    }
}

// parsetext(p, s): the value of a typed text ("250 ms", "2k", "-6 dB",
// "70 %"), as the synth's ParamText.h reads it; nil when it is none.
parsetext(p, s) {
    s = trim(s);
    local u = p["unit"], has = fn(x) { return find(s, x) >= 0; };

    if (u == "dB" && has("inf")) {
        return 0.0;
    }
    local v = _number(s);

    if (v == nil) {
        return nil;
    }

    if (p["kind"] == "int") {
        return round(v);
    } else if (u == "s") {
        return has("ms") ? v / 1000 : has("s") ? v : v < 20 ? v : v / 1000;
    } else if (u == "%") {
        return !has("%") && v <= 1 ? v : v / 100;
    } else if (u == "dB") {
        return pow(10.0, v / 20);
    } else if (u == "Hz") {
        return has("k") || has("K") ? v * 1000 : v;
    }
    return v;
}

// Keeping in step

// show(id, v): puts the synth's value v in the control of id; for an id
// "cable:input", v is the input's pins.
show(id, v) {
    if (_cable(id) != nil) {
        cables[_cable(id)] = v;
        drawrow(_index(inputs, _cable(id)));
        return;
    }
    local c = controls[id];

    if (c == nil || v == nil) {
        return;
    }

    if (c["kind"] == "choice") {
        c["box"]->settext(str(v));
    } else {
        c["scale"]->setvalue(position(c["p"], v));
        c["entry"]->settext(text(c["p"], v));
    }
}

// busy(id): whether the user has the control of id (holds it, moved it a
// moment ago, or its write is still to go).
busy(id) {
    return held[id] == true || touched[id] != nil && touched[id] > clock() || haskey(pending, id);
}

// moved(id, pos): the user moved a fader.
moved(id, pos) {
    local c = controls[id], v = valueat(c["p"], pos);
    c["entry"]->settext(text(c["p"], v));
    touched[id] = clock() + SETTLE;
    pending[id] = v;

    if (flushing == nil) {
        flush();
    }
}

// flush(): writes what the faders moved to, then waits THROTTLE before
// the next writes: a fader moved in between is written once, its last
// value.
flush() {
    flushing = nil;

    if (len(pending) == 0) {
        return;
    }
    local now = pending;
    pending = {};

    for (local id, v in now) {
        write(id, v);
    }
    flushing = events::after(THROTTLE, flush);
}

// setnow(id, v): writes a value at once (typed, reset, chosen).
setnow(id, v) {
    touched[id] = clock() + SETTLE;
    pending = _without(pending, id);
    write(id, v);
}

_without(m, key) {
    local out = {};

    for (local k, v in m) {
        if (k != key) {
            out[k] = v;
        }
    }
    return out;
}

// _cable(id): the input of an id "cable:input", else nil.
_cable(id) {
    return find(id, "cable:") == 0 ? slice(id, 6) : nil;
}

// _index(v, x): where x is in v, or -1.
_index(v, x) {
    for (local i = 0; i < len(v); i++) {
        if (v[i] == x) {
            return i;
        }
    }
    return -1;
}

// write(id, v): a parameter, or the pins of an input for "cable:input".
// What the synth refuses goes to the status line, and the control shows
// what the synth has again.
write(id, v) {
    if (synth->closed()) {
        return;
    }
    local input = _cable(id);

    try {
        if (input != nil) {
            synth->setcables(input, v);
            trace("write cables", input, lmw::formatpins(v));
        } else {
            synth->set(id, v);
            trace("write", id, typeof(v) == "float" ? lmw::number(v, 7) : v);
        }
    } catch (e) {
        failed(e);

        if (!synth->closed()) {
            trace("refused", id, e->message);

            try {
                show(id, input != nil ? _pinsof(synth->cables(), input) : synth->get(id));
            } catch (again) {
                failed(again);
            }
        }
    }
}

// _pinsof(cables, input): the pins of input in a map of cables ([] when
// it has none).
_pinsof(m, input) {
    return m[input] == nil ? [] : m[input];
}

// poll(): what changed on the synth, shown; a control the user has is
// shown once the user lets go.
poll() {
    if (synth->closed()) {
        return;
    }
    local ch = nil;

    try {
        ch = synth->changes();
    } catch (e) {
        return failed(e);
    }
    local params = ch["params"] == nil ? {} : ch["params"], first = !shown;

    for (local id, v in params) {
        latest[id] = v;
        stale[id] = true;
    }

    for (local input, pins in ch["cables"] == nil ? {} : ch["cables"]) {
        latest["cable:" + input] = pins;
        stale["cable:" + input] = true;
    }
    local done = [];

    for (local id, _ in stale) {
        if (!busy(id)) {
            show(id, latest[id]);
            push(done, id);

            if (shown && _cable(id) != nil) {
                trace("show cables", _cable(id), lmw::formatpins(latest[id]));
            } else if (shown) {
                trace("show", id, latest[id]);
            }
        }
    }

    for (local id in done) {
        stale = _without(stale, id);
    }

    if (!shown) {
        shown = true;
        trace("shown all", len(params));
    }

    if (haskey(ch, "name")) {
        patchtitle = ch["name"];
        patchname->settext("Patch: " + patchtitle);
    }

    if (haskey(ch, "notes")) {
        shownotes(first);
    }
}

// failed(e): a refusal of the synth goes to the status line; a lost
// connection greys the window.
failed(e) {
    if (e->kind != "NetError" && !synth->closed()) {
        say(e->message);
        return;
    }

    if (!synth->closed()) {
        synth->close();
    }
    enable(false);
    say("The connection to the synth is lost (" + e->message + "). Nothing is lost on the synth's side.");
    trace("lost");
}

// enable(on): every control usable, or greyed: the faders and lists,
// the matrix (drawn in the disabled colour), the notes, Load and Save. The
// list of synths stays: it is a way to another synth.
enable(on) {
    connected = on;

    for (local id, c in controls) {
        if (c["kind"] == "choice") {
            c["box"]->configure({"state": on ? "readonly" : "disabled"});
        } else {
            c["scale"]->configure({"state": on ? "normal" : "disabled"});
            c["entry"]->configure({"state": on ? "normal" : "disabled"});
        }
    }
    local state = {"state": on ? "normal" : "disabled"};
    notesbox->configure(state);
    loadbutton->configure(state);
    savebutton->configure(state);
    reconnect->configure({"state": on ? "disabled" : "normal"});
    drawmatrix();
}

connectagain() {
    switchto(address);
}

// switchto(a): connects to the synth at a, and shows what it has; when it
// does not answer, the GUI stays with the synth it has.
switchto(a) {
    local other = nil;

    try {
        other = lmw::connect(a);

        if (other->info() == nil) {
            other->close();
            throw new Error("it has no /info (a newer synth is needed)");
        }
    } catch (e) {
        say("Cannot connect to " + a + ": " + e->message);
        synthlist->settext(label(address));
        return;
    }
    flush();
    savenotes();
    // Notes typed but not written when the connection was lost: kept for
    // the same synth, written once it is back.
    local keep = synth->closed() && notesdirty && other->address == address ? notesbox->text() : nil;

    if (!synth->closed()) {
        synth->close();
    }
    synth = other;
    address = synth->address;
    window->settitle("LMW-Synth: " + address);
    synthlist->settext(label(address));
    shown = false;
    stale = {};
    latest = {};
    pending = {};
    cables = {};
    notestext = "";
    notesdirty = false;
    patchtitle = "";
    patchname->settext("Patch:");
    enable(true);
    notesbox->settext(keep == nil ? "" : keep);
    notesdirty = keep != nil;   // the poll leaves them alone
    say("Connected to " + address + ".");
    trace("connected", address);
    poll();

    if (keep != nil) {
        savenotes();
    }
}

// label(a): how the list in the header shows the synth at address a: a
// Unix socket by its name (the synth's process id and number, "4711-1"),
// another address as it is.
label(a) {
    if (find(a, "unix://") == 0 && fs::ext(a) == ".sock") {
        local name = fs::base(a);
        return slice(name, 0, len(name) - 5);
    }
    return a;
}

// listsynths(): the synths in the list of the header: the sockets of
// running synths, and the one the GUI has.
listsynths() {
    local found = lmw::sockets(), items = [];

    if (_index(found, address) < 0) {
        push(found, address);
    }
    synths = {};

    for (local a in found) {
        local l = label(a);

        if (haskey(synths, l)) {   // two directories with the same name in them
            l = a;
        }
        synths[l] = a;
        push(items, l);
    }

    if (join(items, " ") != join(synthlist->items(), " ")) {
        synthlist->setitems(items);
        trace("synths", join(found, " "));
    }
}

quit() {
    flush();
    savenotes();

    if (lister != nil) {
        lister->cancel();
    }

    if (flushing != nil) {
        flushing->cancel();
    }

    if (poller != nil) {
        poller->cancel();
    }

    if (!synth->closed()) {
        synth->close();
    }

    if (server != nil) {
        server->close();
    }
    return true;
}

// Patch files and notes (docs/future.md §13.5)

global PATCHTYPES = [["LMW-Synth patches", ".lmwpatch"], ["All files", "*"]];

// loadpatch(): a patch file chosen by the user, loaded into the synth
// (which checks it: its message goes to the status line).
loadpatch() {
    if (synth->closed()) {
        return;
    }
    local path = tk::openfile({"title": "Load a patch", "types": PATCHTYPES, "parent": window});

    if (path == nil) {
        return;
    }
    flush();
    savenotes();

    try {
        synth->load(readfile(path));
        say("Loaded " + path + ".");
        trace("loaded", fs::base(path));
    } catch (e) {
        failed(e);
        trace("refused", "patch", e->message);
    }
}

// savepatch(): the synth's patch, written to a file the user chooses.
savepatch() {
    if (synth->closed()) {
        return;
    }
    flush();
    savenotes();
    local name = patchtitle == "" ? "patch" : patchtitle;
    local path = tk::savefile({"title": "Save the patch", "types": PATCHTYPES, "ext": ".lmwpatch", "file": name + ".lmwpatch", "parent": window});

    if (path == nil) {
        return;
    }

    try {
        writefile(path, synth->patch());
        say("Saved " + path + ".");
        trace("saved", fs::base(path));
    } catch (e) {
        failed(e);
    }
}

// makenotes(page, chain): the Notes tab: the text is written a second
// after typing stops, and when it loses the keyboard.
makenotes(page, chain) {
    notesbox = new tk::Text(page, {"width": 80, "height": 24, "wrap": "word", "scroll": "y"});
    notesbox->pack({"fill": "both", "expand": true});

    if (verbose) {
        push(geometry, ["notes", extend(chain, cell(notesbox))]);
    }
    local typed = fn() {
        if (notesbox->text() != notestext) {
            notesdirty = true;

            if (notestimer != nil) {
                notestimer->cancel();
            }
            notestimer = events::after(1, savenotes);
        }
    };
    notesbox->bind("<KeyRelease>", fn(e) { typed(); });
    notesbox->bind("<ButtonRelease-2>", fn(e) { events::after(0, typed); });   // a paste comes after this
    notesbox->bind("<FocusOut>", fn(e) { savenotes(); });
}

// savenotes(): the notes, written when they differ from the synth's.
savenotes() {
    if (notestimer != nil) {
        notestimer->cancel();
        notestimer = nil;
    }

    if (notesbox == nil || synth->closed()) {
        return;
    }
    local t = notesbox->text();

    if (t == notestext) {
        notesdirty = false;
        return;
    }

    try {
        synth->setnotes(t);
        notestext = t;
        notesdirty = false;
        trace("write notes", len(t), "bytes");
    } catch (e) {
        failed(e);
    }
}

// shownotes(first): the synth's notes, shown unless the user has changes
// not yet written (they win: they are written next); first: at the first
// poll (no -v line).
shownotes(first) {
    local n = "";

    try {
        n = synth->notes();
    } catch (e) {
        return failed(e);
    }

    if (notesdirty || n == notestext) {
        return;
    }
    notestext = n;
    notesbox->settext(n);

    if (!first) {
        trace("show notes", len(n), "bytes");
    }
}

// The matrix (docs/future.md §13.5, the synth's MatrixView.cpp)

// makematrix(page, chain): the canvas of the Matrix tab, its rows and
// columns from /ports.
makematrix(page, chain) {
    local ports = synth->ports();

    for (local i in ports["inputs"]) {
        push(inputs, i["name"]);
        normalled[i["name"]] = i["normalled"];
    }
    outputs = ports["outputs"];
    matrix = new tk::Canvas(
        page,
        {"width": LABELW + len(outputs) * CELLW + 2, "height": HEADH + len(inputs) * CELLH + 2, "background": lmwtheme::WHITE},
    );
    matrix->pack();

    if (verbose) {
        push(geometry, ["matrix", extend(chain, cell(matrix))]);
        trace("matrix cells", LABELW, HEADH, CELLW, CELLH);
    }
    matrix->bind("<Button-1>", fn(e) {
        matrix->focus();
        local c = cellat(e["x"], e["y"]);
        drag = nil;

        if (c != nil && !synth->closed()) {
            cursor = c;
            drawcursor();
            drag = {"cell": c, "start": level(c), "y": e["y"], "moved": false};
            held["cable:" + inputs[c[0]]] = true;
        }
    });
    matrix->bind("<B1-Motion>", fn(e) {
        if (drag == nil || gate(inputs[drag["cell"][0]])) {
            return;
        }
        local dy = e["y"] - drag["y"];

        if (!drag["moved"] && abs(dy) < 3) {
            return;
        }
        drag["moved"] = true;
        setpin(drag["cell"], drag["start"] - dy / 150.0);   // 1 % per 1.5 pixels, up is more
    });
    matrix->bind("<ButtonRelease-1>", fn(e) {
        if (drag == nil) {
            return;
        }
        local c = drag["cell"], at = cellat(e["x"], e["y"]), key = "cable:" + inputs[c[0]];
        held[key] = false;
        touched[key] = clock() + SETTLE;

        if (!drag["moved"] && at != nil && at[0] == c[0] && at[1] == c[1]) {
            setpin(c, level(c) > 0 ? 0.0 : 1.0);
        }
        drag = nil;
    });
    matrix->bind("<Double-Button-1>", fn(e) {
        local c = cellat(e["x"], e["y"]);

        if (c != nil && !gate(inputs[c[0]]) && !synth->closed()) {
            asklevel(c);
        }
    });
    matrix->bind("<Motion>", fn(e) {
        local c = cellat(e["x"], e["y"]);

        if (c != nil) {
            say(describe(c));
        }
    });
    matrix->bind("<FocusIn>", fn(e) {
        focused = true;
        drawcursor();
    });
    matrix->bind("<FocusOut>", fn(e) {
        focused = false;
        drawcursor();
    });
    matrix->bind("<Key>", key);
}

// gate(input): whether an input is on or off only (an envelope's gate).
gate(input) {
    local dot = find(input, ".");
    return slice(input, dot + 1) == "gate";
}

// cellat(x, y): the cell [input index, output index] at a point of the
// canvas, or nil.
cellat(x, y) {
    if (x < LABELW || y < HEADH) {
        return nil;
    }
    local o = (x - LABELW) / CELLW, i = (y - HEADH) / CELLH;
    return i < len(inputs) && o < len(outputs) ? [i, o] : nil;
}

// level(c): the level of the cable of cell c, 0 for none.
level(c) {
    for (local p in _pinsof(cables, inputs[c[0]])) {
        if (p[0] == outputs[c[1]]) {
            return p[1];
        }
    }
    return 0.0;
}

// setpin(c, l): the cable of cell c at level l (whole percents; 0 takes
// it out; a gate's is on or off), shown at once and written (at most every
// THROTTLE, as a fader).
setpin(c, l) {
    local input = inputs[c[0]], output = outputs[c[1]];

    if (synth->closed()) {
        return;
    }
    l = max(0.0, min(1.0, round(l * 100) / 100.0));

    if (gate(input)) {
        l = l > 0 ? 1.0 : 0.0;
    }

    if (abs(l - level(c)) < 1e-6) {
        return;
    }
    local pins = [], found = false;

    for (local p in _pinsof(cables, input)) {
        if (p[0] == output) {
            found = true;

            if (l > 0) {
                push(pins, [output, l]);
            }
        } else {
            push(pins, p);
        }
    }

    if (!found && l > 0) {
        push(pins, [output, l]);   // a fifth is the synth's to refuse
    }
    cables[input] = pins;
    drawrow(c[0]);
    local key = "cable:" + input;
    touched[key] = clock() + SETTLE;
    pending[key] = pins;

    if (flushing == nil) {
        flush();
    }
}

// key(e): the keys of the matrix (as the synth's).
key(e) {
    local k = e["key"], ch = e["char"], c = cursor;

    if (k == "Up" || k == "Down" || k == "Left" || k == "Right") {
        local di = k == "Up" ? -1 : k == "Down" ? 1 : 0, dout = k == "Left" ? -1 : k == "Right" ? 1 : 0;
        cursor = [max(0, min(len(inputs) - 1, c[0] + di)), max(0, min(len(outputs) - 1, c[1] + dout))];
        drawcursor();
    } else if (k == "space" || k == "Return") {
        setpin(c, level(c) > 0 ? 0.0 : 1.0);
    } else if (k == "Delete" || k == "BackSpace" || k == "End") {
        setpin(c, 0.0);
    } else if (k == "Home") {
        setpin(c, 1.0);
    } else if (k == "Prior" || k == "Next") {
        setpin(c, level(c) + (k == "Prior" ? 0.01 : -0.01));
    } else if (ch == "+" || ch == "=" || ch == "-" || ch == "_") {
        setpin(c, level(c) + (ch == "+" || ch == "=" ? 0.1 : -0.1));
    } else {
        return;
    }
    return false;   // the key is the matrix's
}

// describe(c): what cell c is, and what can be done with it.
describe(c) {
    local input = inputs[c[0]], output = outputs[c[1]], l = level(c), state = "no cable";

    if (l > 0) {
        state = "cable at " + str(round(l * 100)) + " %";
    } else if (len(_pinsof(cables, input)) == 0 && normalled[input] == output) {
        state = "normalled (used while this input has no cables)";
    }
    local how = gate(input) ? "Click: on/off." : "Click: on/off. Drag up/down: level. Double-click: type the level.";

    if (l == 0 && len(_pinsof(cables, input)) >= 4) {
        how = "This input already has 4 cables.";
    }
    return output + " → " + input + ": " + state + ". " + how;
}

// asklevel(c): a small window that asks for the level of cell c.
asklevel(c) {
    local w = new tk::Window("Cable level"), f = new tk::Frame(w, {"padding": 10});
    f->pack({"fill": "both", "expand": true});
    new tk::Label(f, outputs[c[1]] + " → " + inputs[c[0]] + "\nLevel in percent (0 removes the cable):")->pack();
    local entry = new tk::Entry(f, str(round(level(c) * 100)), {"width": 8, "justify": "center"});
    entry->pack({"pady": 6});
    local ok = fn(text) {
        local t = trim(replace(text, "%", "")), v = nil;

        try {
            v = float(t);
        } catch (e) {
        }

        if (v == nil || v < 0) {
            say("Not a level: " + text);
        } else {
            setpin(c, v / 100.0);
        }
        w->close();
    };
    entry->onenter(ok);
    local buttons = new tk::Frame(f);
    buttons->pack();
    new tk::Button(buttons, "OK")->onclick(fn() { ok(entry->text()); })->pack({"side": "left", "padx": 4});
    new tk::Button(buttons, "Cancel")->onclick(fn() { w->close(); })->pack({"side": "left", "padx": 4});
    w->bind("<Key-Escape>", fn(e) { w->close(); });
    entry->focus();
}

// The drawing: tags h (heads and labels), r<i> (the cells of row i), grid
// and cursor.

_box(i, o) {
    local x = LABELW + o * CELLW, y = HEADH + i * CELLH;
    return [x, y, x + CELLW, y + CELLH];
}

_module(port) {
    return slice(port, 0, find(port, "."));
}

// ink(): the colour the matrix is drawn in: black, or while the synth is
// lost the colour of disabled text (black too at Max).
ink() {
    return connected ? lmwtheme::BLACK : theme["tk"]["disabled"];
}

// drawmatrix(): all of it (at the start, and for new colours).
drawmatrix() {
    if (matrix == nil || theme == nil) {
        return;
    }
    matrix->clear();
    local units = theme["units"], black = ink();
    local right = LABELW + len(outputs) * CELLW, bottom = HEADH + len(inputs) * CELLH;

    for (local o = 0; o < len(outputs); o++) {
        local x = LABELW + o * CELLW, name = outputs[o], dot = find(name, ".");
        matrix->rect(x, 0, x + CELLW, HEADH, {"fill": units[lmwtheme::unit(name)], "outline": ""});
        matrix->text(x + CELLW / 2, HEADH / 2 - 1, slice(name, 0, dot), {"anchor": "s", "color": black, "font": {"bold": true, "size": 9}});
        matrix->text(x + CELLW / 2, HEADH / 2 + 1, slice(name, dot + 1), {"anchor": "n", "color": black, "font": {"bold": true, "size": 9}});
    }

    for (local i = 0; i < len(inputs); i++) {
        local y = HEADH + i * CELLH, name = inputs[i];
        matrix->rect(0, y, LABELW, y + CELLH, {"fill": units[lmwtheme::unit(name)], "outline": ""});
        matrix->text(LABELW - 6, y + CELLH / 2, name + (gate(name) ? " (on/off)" : ""), {"anchor": "e", "color": black, "font": {"size": 9}});
    }

    for (local o = 0; o <= len(outputs); o++) {   // thin lines, thick between modules
        local x = LABELW + o * CELLW;
        local edge = o == 0 || o == len(outputs) || _module(outputs[o]) != _module(outputs[o - 1]);
        matrix->line([x, edge ? 0 : HEADH, x, bottom], {"color": black, "width": edge ? 2 : 1});
    }

    for (local i = 0; i <= len(inputs); i++) {
        local y = HEADH + i * CELLH;
        local edge = i == 0 || i == len(inputs) || _module(inputs[i]) != _module(inputs[i - 1]);
        matrix->line([edge ? 0 : LABELW, y, right, y], {"color": black, "width": edge ? 2 : 1});
    }

    for (local i = 0; i < len(inputs); i++) {
        drawrow(i);
    }
    drawcursor();
}

// drawrow(i): the cells of row i: a cable as its level in % over a bar
// filled to it; the normalled source of an input without cables as a
// ring.
drawrow(i) {
    if (matrix == nil || theme == nil || i < 0) {
        return;
    }
    local tag = "r" + str(i), black = ink(), input = inputs[i];
    matrix->remove(tag);
    local items = [];

    for (local o = 0; o < len(outputs); o++) {
        local b = _box(i, o), l = level([i, o]);
        local x1 = b[0] + 3, y1 = b[1] + 3, x2 = b[2] - 3, y2 = b[3] - 3;

        if (l > 0) {
            push(items, matrix->rect(x1, y1, x2, y2, {"outline": black, "width": 1}));
            push(items, matrix->rect(x1, y2 - 4, x1 + max(2, round((x2 - x1) * l)), y2, {"fill": black, "outline": ""}));
            push(items, matrix->text((x1 + x2) / 2, y1 + 1, str(round(l * 100)) + " %", {"anchor": "n", "color": black, "font": {"size": 8}}));
        } else if (len(_pinsof(cables, input)) == 0 && normalled[input] == outputs[o]) {
            local cx = (b[0] + b[2]) / 2, cy = (b[1] + b[3]) / 2;
            push(items, matrix->oval(cx - 5, cy - 5, cx + 5, cy + 5, {"outline": black, "width": 2}));
        }
    }

    for (local id in items) {
        matrix->tag(id, tag);
    }
    matrix->raise("cursor");
}

// drawcursor(): the cell cursor, while the matrix has the keyboard.
drawcursor() {
    if (matrix == nil) {
        return;
    }
    matrix->remove("cursor");

    if (focused) {
        local b = _box(cursor[0], cursor[1]);
        matrix->tag(matrix->rect(b[0] + 1, b[1] + 1, b[2] - 1, b[3] - 1, {"outline": ink(), "width": 3}), "cursor");
    }
}

// Contrast (docs/future.md §13.7)

// setcontrast(p, r, save): the colours of preset p (r: the ratio for
// "Custom", a number or its text); with save, kept in the settings file.
setcontrast(p, r, save) {
    local minimum = 0.0;

    try {
        minimum = lmwtheme::ratio(p, typeof(r) == "string" ? float(trim(r)) : r);
    } catch (e) {
        say("Contrast: " + e->message);
        return;
    }
    theme = lmwtheme::palette(minimum);
    tk::setcolors(theme["tk"]);
    drawmatrix();

    for (local t in titles) {
        t[0]->configure({"background": theme["units"][t[1]], "foreground": lmwtheme::BLACK});
    }
    preset = p;
    ratio = minimum;
    contrast->settext(p);
    customratio->settext(str(minimum));
    customratio->configure({"state": p == "Custom" ? "normal" : "disabled"});
    trace("contrast", p, minimum);

    if (save) {
        saveconfig();
    }
}

// The settings file: [contrast] preset = "AA", ratio = 4.5.

readconfig() {
    if (configpath == nil) {
        local dir = getenv("XDG_CONFIG_HOME");

        if (dir == nil || dir == "") {
            dir = getenv("APPDATA");
        }

        if (dir == nil || dir == "") {
            dir = fs::join(getenv("HOME") == nil ? "." : getenv("HOME"), ".config");
        }
        configpath = fs::join(dir, "lmw-gui.toml");
    }

    if (!fs::exists(configpath)) {
        return;
    }

    try {
        local c = toml::decode(readfile(configpath))["contrast"];

        if (c != nil) {
            local p = c["preset"] == nil ? "AA" : c["preset"], r = c["ratio"] == nil ? 4.5 : c["ratio"];
            ratio = lmwtheme::ratio(p, r);
            preset = p;
        }
    } catch (e) {
        eprintln("lmwgui:", configpath + ":", e->message, "(the contrast is AA)");
    }
}

saveconfig() {
    try {
        fs::mkdirall(fs::dir(configpath));
        writefile(configpath, toml::encode({"contrast": {"preset": preset, "ratio": ratio}}));
    } catch (e) {
        say("Cannot save the settings: " + e->message);
    }
}
