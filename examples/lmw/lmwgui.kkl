// lmwgui.kkl: a GUI for LMW-Synth over 9P (docs/future.md §13), with the
// module tk (a kukel built with the build tag tk, and a display):
//
//     kukel run lmwgui.kkl [-- [-a address | -fake] [-config file] [-tab name] [-v]]
//
// -a address: the synth (as lmwctl takes it); without it, the newest synth
// socket that answers. -fake: a fake synth in this program (fakesynth.kkl).
// -config file: the settings file instead of lmw-gui.toml in the user's
// configuration directory. -tab name: the tab shown first (Synth, Effects,
// Matrix, Schematic or Notes). -v: prints what it shows and writes, for the
// tests.
//
// The Synth tab has the synth's module panels, the Effects tab the reverb.
// A fader writes its parameter at most every 20 ms while it moves; every
// 200 ms the GUI asks the synth what changed and shows it, except on a
// fader the user holds (until half a second after it is let go). A value
// can be typed under a fader (Enter); a double click on a fader resets it.
// The Matrix tab has a row per input and a column per output: a click
// puts a cable in or takes it out, dragging up or down sets its level, a
// double click asks for it; the arrow keys move a cell cursor, Space
// toggles, + and - change by 10 %, Delete removes. The Schematic tab
// draws the synth as its own Schematic tab does (the blocks where the synth
// has them): dragging from a port to a port of the other kind puts a cable
// in, dragging a plugged input's newest cable moves it to another input or
// takes it out; the arrow keys move a port cursor, Enter or a right click
// opens a menu of the port's cables, Delete takes an input's cables out,
// Escape cancels a drag. The Notes tab is the
// patch's notes, written a second after typing stops and when the text
// loses the keyboard.
//
// Load and Save (Ctrl+O, Ctrl+S) read a patch file into the synth and
// write the synth's patch to a file; Ctrl+Q quits.
//
// Under the tabs is a keyboard of 88 keys (A0 to C8), as the synth's: a
// click plays a note (soft near the top of a key, loud near the bottom),
// dragging plays the keys passed over. While it has the keyboard (a click
// gives it), the keys a w s e d f t g y h u j k o l p ; play from C4 up,
// z and x shift them an octave down or up. The list in the header
// has the synths that are running (their sockets), to switch to another.
// The contrast (AA, AAA, Max or a custom ratio) is kept in the settings
// file.
use tk;
use events;
use lmw;
use lmwtheme;
use lmwschematic;
use fakesynth;
use toml;
use fs;

// The panels in the synth's rows (its Spec S6.1): a title and the controls,
// each [id, label]; a vector of two of them is a column of two choices.
global SYNTH = [
    [
        ["VCO 1", [["vco1.fm", "FM"], ["vco1.tune", "Tune"], [["vco1.wave", "Wave"], ["vco1.octave", "Oct"]]]],
        ["VCO 2", [["vco2.fm", "FM"], ["vco2.tune", "Tune"], [["vco2.wave", "Wave"], ["vco2.octave", "Oct"]]]],
        ["VCO 3", [["vco3.fm", "FM"], ["vco3.tune", "Tune"], [["vco3.wave", "Wave"], ["vco3.octave", "Oct"]]]],
        ["NOISE", [["noise.colour", "Colour"], ["noise.rate", "Rate"], ["noise.smooth", "Smooth"]]],
        ["LFO 1", [["lfo1.wave", "Wave"], ["lfo1.rate", "Rate"]]],
    ],
    [
        ["MIXER", [["mix.vco1", "VCO 1"], ["mix.vco2", "VCO 2"], ["mix.vco3", "VCO 3"], ["mix.noise", "Noise"]]],
        [
            "VCF 1",
            [
                ["vcf1.cutoff", "Cutoff"], ["vcf1.res", "Reso"], ["vcf1.env", "Env 2"], ["vcf1.key", "Key"],
                [["vcf1.slope", "Slope"], ["vcf1.type", "Type"]],
            ],
        ],
        [
            "VCF 2",
            [
                ["vcf2.cutoff", "Cutoff"], ["vcf2.res", "Reso"], ["vcf2.env", "Env 2"], ["vcf2.key", "Key"],
                [["vcf2.slope", "Slope"], ["vcf2.type", "Type"]],
            ],
        ],
    ],
    [
        ["KEYS", [["voice.count", "Voices"]]],
        ["ENV 1 → VCA", [["env1.attack", "Attack"], ["env1.decay", "Decay"], ["env1.sustain", "Sustain"], ["env1.release", "Release"]]],
        ["ENV 2 → VCF", [["env2.attack", "Attack"], ["env2.decay", "Decay"], ["env2.sustain", "Sustain"], ["env2.release", "Release"]]],
        ["LFO 2", [["lfo2.wave", "Wave"], ["lfo2.rate", "Rate"]]],
        ["VCA", [["vca.initial", "Initial"], ["vca.tremolo", "Tremolo"]]],
        ["OUT", [["out.gain", "Volume"]]],
    ],
];
global EFFECTS = [[["REVERB", [["reverb.mix", "Mix"], ["reverb.size", "Size"], ["reverb.damping", "Damping"], ["reverb.width", "Width"]]]]];

const STEPS = 1000;      // a fader's positions
const THROTTLE = 0.02;   // seconds between the writes of a moving fader
const POLL = 0.2;        // seconds between the questions to the synth
const SETTLE = 0.5;      // seconds a fader is left alone after the user

global window, synth, address, server = nil, verbose = false;
global status, patchname, reconnect, contrast, customratio;
global controls = {};    // id -> {"p", "kind", "scale", "entry", "box"}
global titles = [];      // [label, unit kind] of each panel title
global held = {}, touched = {}, latest = {}, stale = {};
global pending = {}, flushing = nil, poller = nil, shown = false;
global configpath, preset = "AA", ratio = 4.5;
global geometry = [], placed = {}, placing = false;   // -v: where the faders are
global tabs, theme = nil;
global matrix = nil, inputs = [], outputs = [], normalled = {}, cables = {};
global cursor = [0, 0], focused = false, drag = nil;
global notesbox = nil, notestext = "", notesdirty = false, notestimer = nil;
global synthlist, lister = nil, patchtitle = "", synths = {};   // label -> address
global loadbutton, savebutton, connected = true;
global schem = nil, slayout = nil, keyamount = {"vcf1.key": 0.0, "vcf2.key": 0.0};
global scursor = 0, sfocused = false, sdrag = nil, sdrawing = false;
global piano = nil, down = {}, mousekey = nil, typed = {}, releases = {}, shift = 0, pianofocus = false;

// The keyboard: notes 21 (A0) to 108 (C8), key sizes in pixels, and the
// computer keys from C upward (as JUCE's).
const LOWNOTE = 21;
const HIGHNOTE = 108;
const KEYW = 17;
const KEYH = 46;
const BLACKW = 11;
const BLACKH = 28;
const QWERTY = "awsedftgyhujkolp;";

// The matrix's sizes in pixels: the labels of the rows, the heads of the
// columns, a cell.
const LABELW = 150;
const HEADH = 36;
const CELLW = 46;
const CELLH = 22;

// The schematic's canvas: pixels per unit, and the margin around it.
const SCALE = 6.4;
const MARGIN = 4;

// The panels are compact, so that the window fits a 1024 by 768 screen:
// the controls' texts in a smaller font, short faders.
global SMALL = {"size": 8};
const FADER = 96;   // a fader's length in pixels

main(args) {
    local fake = false, i = 0, first = "Synth";
    configpath = nil;

    for (; i < len(args); i++) {
        if (args[i] == "-a" && i + 1 < len(args)) {
            address = args[++i];
        } else if (args[i] == "-fake") {
            fake = true;
        } else if (args[i] == "-config" && i + 1 < len(args)) {
            configpath = args[++i];
        } else if (args[i] == "-tab" && i + 1 < len(args)) {
            first = args[++i];
        } else if (args[i] == "-v") {
            verbose = true;
        } else {
            eprintln("usage: lmwgui [-a address | -fake] [-config file] [-tab Synth|Effects|Matrix|Schematic|Notes] [-v]");
            return 2;
        }
    }

    try {
        if (fake) {
            server = new fakesynth::Synth()->serve("tcp://127.0.0.1:0");
            address = server->endpoint();
        }
        synth = lmw::connect(address);
        address = synth->address;

        if (synth->info() == nil) {
            throw new Error("this synth has no /info (it describes the parameters): a newer synth is needed");
        }
    } catch (e) {
        eprintln("lmwgui:", e->message);

        if (server != nil) {
            server->close();
        }
        return 1;
    }
    readconfig();

    try {
        build(first);
    } catch (e) {
        eprintln("lmwgui:", e->message);
        quit();

        if (window != nil) {
            window->close();
        }
        return 1;
    }
    trace("connected", address);
    setcontrast(preset, ratio, false);
    poll();
    poller = events::every(POLL, poll);
    listsynths();
    lister = events::every(2, listsynths);
    events::run();
    return 0;
}

// trace(words...): a line for -v (the tests read it at once).
trace(words..) {
    if (verbose) {
        println(words..);
        fs::stdout()->flush();
    }
}

// extend(v, x...): a new vector of v's elements and then x.
extend(v, more..) {
    local out = [];

    for (local x in v) {
        push(out, x);
    }

    for (local x in more) {
        push(out, x);
    }
    return out;
}

// cell(w): for -v, w's place in its parent, kept up to date: a map with
// x, y, w and h once Tk placed it.
cell(w) {
    local c = {};

    if (verbose) {
        w->bind("<Configure>", fn(e) {
            c["x"] = e["x"];
            c["y"] = e["y"];
            c["w"] = e["width"];
            c["h"] = e["height"];

            if (!placing) {
                placing = true;
                events::post(places);
            }
        });
    }
    return c;
}

// places(): for -v, "at id x y w h" for each fader that moved: its place
// in the window.
places() {
    placing = false;

    for (local g in geometry) {
        local x = 0, y = 0, last = nil;

        for (local c in g[1]) {
            if (c["x"] == nil) {
                last = nil;
                break;
            }
            x += c["x"];
            y += c["y"];
            last = c;
        }

        if (last != nil) {
            local s = join([x, y, last["w"], last["h"]], " ");

            if (placed[g[0]] != s) {
                placed[g[0]] = s;
                trace("at", g[0], s);
            }
        }
    }
}

say(text) {
    status->settext(text);
}

// The window

build(first) {
    window = new tk::Window("LMW-Synth: " + address);
    window->onclose(quit);
    local head = new tk::Frame(window, {"padding": [6, 4]});
    head->pack({"fill": "x"});
    local headcell = cell(head);   // one: a second bind would replace the first

    // From the left: the synth (first: the window may be wider than the
    // screen), the patch, the contrast.
    new tk::Label(head, "Synth:")->pack({"side": "left"});
    synthlist = new tk::Combobox(head, [label(address)], {"state": "readonly", "width": 14});
    synthlist->settext(label(address));
    synthlist->onselect(fn(l) {
        local a = synths[l] == nil ? l : synths[l];

        if (a != address) {
            switchto(a);
        }
    });
    synthlist->pack({"side": "left", "padx": 4});

    if (verbose) {
        push(geometry, ["synthlist", [headcell, cell(synthlist)]]);
    }
    reconnect = new tk::Button(head, "Connect again", {"state": "disabled"});
    reconnect->onclick(connectagain);
    reconnect->pack({"side": "left"});

    if (verbose) {
        push(geometry, ["reconnect", [headcell, cell(reconnect)]]);
    }
    patchname = new tk::Label(head, "Patch:", {"width": 14});
    patchname->pack({"side": "left", "padx": 12});
    loadbutton = new tk::Button(head, "Load...");
    loadbutton->onclick(loadpatch);
    loadbutton->pack({"side": "left"});
    savebutton = new tk::Button(head, "Save...");
    savebutton->onclick(savepatch);
    savebutton->pack({"side": "left", "padx": 4});
    new tk::Label(head, "Contrast:")->pack({"side": "left", "padx": 4});
    contrast = new tk::Combobox(head, ["AA", "AAA", "Max", "Custom"], {"state": "readonly", "width": 7});
    contrast->pack({"side": "left"});
    customratio = new tk::Entry(head, {"width": 5});
    customratio->pack({"side": "left", "padx": 4});
    contrast->onselect(fn(p) { setcontrast(p, customratio->text(), true); });
    customratio->onenter(fn(text) { setcontrast("Custom", text, true); });

    tabs = new tk::Notebook(window, {"padding": 4});
    tabs->pack({"fill": "both", "expand": true});
    local page = new tk::Frame(tabs, {"padding": 4}), effects = new tk::Frame(tabs, {"padding": 4});
    local cablepage = new tk::Frame(tabs, {"padding": 4}), notespage = new tk::Frame(tabs, {"padding": 4});
    local schempage = new tk::Frame(tabs, {"padding": 4});
    tabs->add(page, "Synth")->add(effects, "Effects")->add(cablepage, "Matrix")->add(schempage, "Schematic")->add(notespage, "Notes");
    local top = [cell(tabs)];
    rows(page, SYNTH, extend(top, cell(page)));
    rows(effects, EFFECTS, extend(top, cell(effects)));
    makematrix(cablepage, extend(top, cell(cablepage)));
    makeschematic(schempage, extend(top, cell(schempage)));
    makenotes(notespage, extend(top, cell(notespage)));
    makepiano(window);
    status = new tk::Label(window, "", {"anchor": "w", "padding": [6, 2]});
    status->pack({"fill": "x"});
    local names = ["Synth", "Effects", "Matrix", "Schematic", "Notes"], found = false;

    for (local i = 0; i < len(names); i++) {
        if (lower(first) == lower(names[i])) {
            tabs->select(i);
            found = true;
        }
    }

    if (!found) {
        throw new Error("there is no tab " + first + " (Synth, Effects, Matrix, Schematic or Notes)");
    }

    // The keys of the window; on the notes too, where Tk's text would
    // otherwise take Ctrl+O as a new line.
    for (local k, f in {"o": loadpatch, "s": savepatch, "q": fn() {
        quit();
        window->close();
    }}) {
        local shortcut = fn(e) {
            f();
            return false;
        };
        window->bind("<Control-Key-" + k + ">", shortcut);
        notesbox->bind("<Control-Key-" + k + ">", shortcut);
    }
    tabs->onchange(tabfocus);
    tabfocus(tabs->selected());
}

// tabfocus(i): the matrix and the schematic take the keyboard when their
// tab opens (as the synth's).
tabfocus(i) {
    if (i == 2) {
        matrix->focus();
    } else if (i == 3) {
        schem->focus();
    }
}

// rows(page, layout, chain): the panels of layout in page; chain is where
// page is (for -v).
rows(page, layout, chain) {
    for (local row in layout) {
        local f = new tk::Frame(page);
        f->pack({"fill": "x"});
        local at = extend(chain, cell(f));   // one cell: a second bind would replace the first

        for (local panel in row) {
            makepanel(f, panel[0], panel[1], at);
        }
    }
}

// makepanel(parent, title, items, chain): a module panel: its title in the
// unit's colour, and a column per control.
makepanel(parent, title, items, chain) {
    local f = new tk::Frame(parent, {"relief": "solid", "borderwidth": 1});
    f->pack({"side": "left", "fill": "y", "padx": 2, "pady": 2});
    local t = new tk::Label(f, title, {"anchor": "center", "padding": [4, 1], "font": {"bold": true, "size": 9}});
    t->pack({"fill": "x"});
    push(titles, [t, lmwtheme::unit(title)]);
    local body = new tk::Frame(f, {"padding": 2}), column = 0;
    body->pack({"fill": "both", "expand": true});
    chain = extend(chain, cell(f), cell(body));

    for (local item in items) {
        local c = new tk::Frame(body);
        c->grid({"row": 0, "column": column++, "sticky": "n", "padx": 1});
        local at = extend(chain, cell(c));

        if (typeof(item[0]) == "vector") {
            for (local sub in item) {
                control(c, sub[0], sub[1], at);
            }
        } else {
            control(c, item[0], item[1], at);
        }
    }
}

// control(parent, id, label, chain): a fader with its value under it, or
// for a choice a drop-down list.
control(parent, id, label, chain) {
    local p = synth->param(id);
    new tk::Label(parent, label, {"anchor": "center", "font": SMALL})->pack({"fill": "x"});

    if (p == nil) {   // the synth has no such parameter
        new tk::Label(parent, "(none)")->pack();
        return;
    }

    if (p["kind"] == "choice") {
        local width = 3;

        for (local name in p["choices"]) {
            width = max(width, len(name));
        }
        local box = new tk::Combobox(parent, p["choices"], {"state": "readonly", "width": width, "font": SMALL});
        box->pack({"pady": 2});
        box->onselect(fn(text) { setnow(id, text); });
        controls[id] = {"p": p, "kind": "choice", "box": box};
        return;
    }
    local scale = new tk::Scale(parent, {"from": STEPS, "to": 0, "step": 1, "orient": "vertical", "length": FADER});
    scale->pack();
    local entry = new tk::Entry(parent, {"width": 7, "justify": "center", "font": SMALL});
    entry->pack({"pady": 2});
    controls[id] = {"p": p, "kind": "fader", "scale": scale, "entry": entry};

    if (verbose) {
        push(geometry, [id, extend(chain, cell(scale))]);
    }
    scale->onchange(fn(pos) { moved(id, pos); });
    scale->bind("<Button-1>", fn(e) { held[id] = true; });
    scale->bind("<ButtonRelease-1>", fn(e) {
        held[id] = false;
        touched[id] = clock() + SETTLE;
    });
    scale->bind("<Double-Button-1>", fn(e) { setnow(id, p["default"]); });
    entry->onenter(fn(text) {
        local v = parsetext(p, text);

        if (v == nil) {
            say(id + ": not a value: " + text);
            show(id, latest[id]);
        } else {
            setnow(id, v);
        }
    });
}

// Faders: positions, values and their text (as the synth's ParamText.h)

// _skew(p): the skew of a fader whose middle is p["centre"] (JUCE's
// setSkewForCentre); 1 for a linear one.
_skew(p) {
    if (p["centre"] == nil) {
        return 1.0;
    }
    return log(0.5) / log((p["centre"] - p["min"]) / (p["max"] - p["min"]));
}

// position(p, v): the fader position (0 to STEPS) of value v.
position(p, v) {
    local x = (float(v) - p["min"]) / (p["max"] - p["min"]);
    x = max(0.0, min(1.0, x));
    return round(pow(x, _skew(p)) * STEPS);
}

// valueat(p, pos): the value at fader position pos, on the step.
valueat(p, pos) {
    local x = float(pos) / STEPS;

    if (x > 0) {
        x = exp(log(x) / _skew(p));
    }
    local v = p["min"] + (p["max"] - p["min"]) * x;

    if (p["kind"] == "int") {
        return round(v);
    }

    if (p["step"] != nil) {
        v = round(v / p["step"]) * p["step"];
    }
    return v;
}

// fixed(x, d): x with d decimals.
fixed(x, d) {
    local n = round(x * pow(10, d)), neg = n < 0;

    if (neg) {
        n = -n;
    }
    local s = str(n);

    if (d > 0) {
        while (len(s) <= d) {
            s = "0" + s;
        }
        s = slice(s, 0, len(s) - d) + "." + slice(s, len(s) - d);
    }
    return (neg ? "-" : "") + s;
}

// text(p, v): the value as the synth shows it under a fader.
text(p, v) {
    if (p["kind"] != "float") {
        return str(v);
    }
    local u = p["unit"];

    if (u == "s") {
        return v < 0.9995 ? fixed(v * 1000, 0) + " ms" : v < 9.995 ? fixed(v, 2) + " s" : fixed(v, 1) + " s";
    } else if (u == "%") {
        return fixed(v * 100, 0) + " %";
    } else if (u == "dB") {
        if (v <= 0) {
            return "-inf dB";
        }
        local db = 20 * log(v) / log(10);
        return fixed(abs(db) < 0.05 ? 0.0 : db, 1) + " dB";
    } else if (u == "Hz") {
        return v < 10 ? fixed(v, 2) + " Hz" : v < 100 ? fixed(v, 1) + " Hz" : v < 999.5 ? fixed(v, 0) + " Hz"
            : v < 9995 ? fixed(v / 1000, 2) + " kHz" : fixed(v / 1000, 1) + " kHz";
    } else if (u == "oct") {
        return abs(v) < 0.05 ? "0.0 oct" : (v > 0 ? "+" : "") + fixed(v, 1) + " oct";
    } else if (u == "st") {
        return fixed(v, 1) + " st";
    }
    return fixed(v, 2);
}

// _number(s): the number at the start of s, or nil.
_number(s) {
    local end = 0, chars = "+-.0123456789eE";

    while (end < len(s) && find(chars, slice(s, end, end + 1)) >= 0) {
        end++;
    }

    try {
        return float(slice(s, 0, end));
    } catch (e) {
        return nil;
    }
}

// parsetext(p, s): the value of a typed text ("250 ms", "2k", "-6 dB",
// "70 %"), as the synth's ParamText.h reads it; nil when it is none.
parsetext(p, s) {
    s = trim(s);
    local u = p["unit"], has = fn(x) { return find(s, x) >= 0; };

    if (u == "dB" && has("inf")) {
        return 0.0;
    }
    local v = _number(s);

    if (v == nil) {
        return nil;
    }

    if (p["kind"] == "int") {
        return round(v);
    } else if (u == "s") {
        return has("ms") ? v / 1000 : has("s") ? v : v < 20 ? v : v / 1000;
    } else if (u == "%") {
        return !has("%") && v <= 1 ? v : v / 100;
    } else if (u == "dB") {
        return pow(10.0, v / 20);
    } else if (u == "Hz") {
        return has("k") || has("K") ? v * 1000 : v;
    }
    return v;
}

// Keeping in step

// show(id, v): puts the synth's value v in the control of id; for an id
// "cable:input", v is the input's pins.
show(id, v) {
    if (_cable(id) != nil) {
        cables[_cable(id)] = v;
        drawrow(_index(inputs, _cable(id)));
        redrawschematic();
        return;
    }
    keyfader(id, v);
    local c = controls[id];

    if (c == nil || v == nil) {
        return;
    }

    if (c["kind"] == "choice") {
        c["box"]->settext(str(v));
    } else {
        c["scale"]->setvalue(position(c["p"], v));
        c["entry"]->settext(text(c["p"], v));
    }
}

// busy(id): whether the user has the control of id (holds it, moved it a
// moment ago, or its write is still to go).
busy(id) {
    return held[id] == true || touched[id] != nil && touched[id] > clock() || haskey(pending, id);
}

// moved(id, pos): the user moved a fader.
moved(id, pos) {
    local c = controls[id], v = valueat(c["p"], pos);
    c["entry"]->settext(text(c["p"], v));
    keyfader(id, v);
    touched[id] = clock() + SETTLE;
    pending[id] = v;

    if (flushing == nil) {
        flush();
    }
}

// flush(): writes what the faders moved to, then waits THROTTLE before
// the next writes: a fader moved in between is written once, its last
// value.
flush() {
    flushing = nil;

    if (len(pending) == 0) {
        return;
    }
    local now = pending;
    pending = {};

    for (local id, v in now) {
        write(id, v);
    }
    flushing = events::after(THROTTLE, flush);
}

// setnow(id, v): writes a value at once (typed, reset, chosen).
setnow(id, v) {
    keyfader(id, v);
    touched[id] = clock() + SETTLE;
    pending = _without(pending, id);
    write(id, v);
}

_without(m, key) {
    local out = {};

    for (local k, v in m) {
        if (k != key) {
            out[k] = v;
        }
    }
    return out;
}

// _cable(id): the input of an id "cable:input", else nil.
_cable(id) {
    return find(id, "cable:") == 0 ? slice(id, 6) : nil;
}

// _index(v, x): where x is in v, or -1.
_index(v, x) {
    for (local i = 0; i < len(v); i++) {
        if (v[i] == x) {
            return i;
        }
    }
    return -1;
}

// write(id, v): a parameter, or the pins of an input for "cable:input".
// What the synth refuses goes to the status line, and the control shows
// what the synth has again.
write(id, v) {
    if (synth->closed()) {
        return;
    }
    local input = _cable(id);

    try {
        if (input != nil) {
            synth->setcables(input, v);
            trace("write cables", input, lmw::formatpins(v));
        } else {
            synth->set(id, v);
            trace("write", id, typeof(v) == "float" ? lmw::number(v, 7) : v);
        }
    } catch (e) {
        failed(e);

        if (!synth->closed()) {
            trace("refused", id, e->message);

            try {
                show(id, input != nil ? _pinsof(synth->cables(), input) : synth->get(id));
            } catch (again) {
                failed(again);
            }
        }
    }
}

// _pinsof(cables, input): the pins of input in a map of cables ([] when
// it has none).
_pinsof(m, input) {
    return m[input] == nil ? [] : m[input];
}

// poll(): what changed on the synth, shown; a control the user has is
// shown once the user lets go.
poll() {
    if (synth->closed()) {
        return;
    }
    local ch = nil;

    try {
        ch = synth->changes();
    } catch (e) {
        return failed(e);
    }
    local params = ch["params"] == nil ? {} : ch["params"], first = !shown;

    for (local id, v in params) {
        latest[id] = v;
        stale[id] = true;
    }

    for (local input, pins in ch["cables"] == nil ? {} : ch["cables"]) {
        latest["cable:" + input] = pins;
        stale["cable:" + input] = true;
    }
    local done = [];

    for (local id, _ in stale) {
        if (!busy(id)) {
            show(id, latest[id]);
            push(done, id);

            if (shown && _cable(id) != nil) {
                trace("show cables", _cable(id), lmw::formatpins(latest[id]));
            } else if (shown) {
                trace("show", id, latest[id]);
            }
        }
    }

    for (local id in done) {
        stale = _without(stale, id);
    }

    if (!shown) {
        shown = true;
        trace("shown all", len(params));
    }

    if (haskey(ch, "name")) {
        patchtitle = ch["name"];
        patchname->settext("Patch: " + patchtitle);
    }

    if (haskey(ch, "notes")) {
        shownotes(first);
    }

    if (haskey(ch, "schematic") || slayout == nil) {
        showlayout(ch["schematic"]);
    }
}

// failed(e): a refusal of the synth goes to the status line; a lost
// connection greys the window.
failed(e) {
    if (e->kind != "NetError" && !synth->closed()) {
        say(e->message);
        return;
    }

    if (!synth->closed()) {
        synth->close();
    }
    enable(false);
    say("The connection to the synth is lost (" + e->message + "). Nothing is lost on the synth's side.");
    trace("lost");
}

// enable(on): every control usable, or greyed: the faders and lists,
// the matrix (drawn in the disabled colour), the notes, Load and Save. The
// list of synths stays: it is a way to another synth.
enable(on) {
    connected = on;

    for (local id, c in controls) {
        if (c["kind"] == "choice") {
            c["box"]->configure({"state": on ? "readonly" : "disabled"});
        } else {
            c["scale"]->configure({"state": on ? "normal" : "disabled"});
            c["entry"]->configure({"state": on ? "normal" : "disabled"});
        }
    }
    local state = {"state": on ? "normal" : "disabled"};
    notesbox->configure(state);
    loadbutton->configure(state);
    savebutton->configure(state);
    reconnect->configure({"state": on ? "disabled" : "normal"});
    sdrag = nil;
    drawmatrix();
    drawschematic();
    drawpiano();
}

connectagain() {
    switchto(address);
}

// switchto(a): connects to the synth at a, and shows what it has; when it
// does not answer, the GUI stays with the synth it has.
switchto(a) {
    local other = nil;

    try {
        other = lmw::connect(a);

        if (other->info() == nil) {
            other->close();
            throw new Error("it has no /info (a newer synth is needed)");
        }
    } catch (e) {
        say("Cannot connect to " + a + ": " + e->message);
        synthlist->settext(label(address));
        return;
    }
    flush();
    savenotes();
    allnotesoff();
    // Notes typed but not written when the connection was lost: kept for
    // the same synth, written once it is back.
    local keep = synth->closed() && notesdirty && other->address == address ? notesbox->text() : nil;

    if (!synth->closed()) {
        synth->close();
    }
    synth = other;
    address = synth->address;
    window->settitle("LMW-Synth: " + address);
    synthlist->settext(label(address));
    shown = false;
    stale = {};
    latest = {};
    pending = {};
    cables = {};
    slayout = nil;
    notestext = "";
    notesdirty = false;
    patchtitle = "";
    patchname->settext("Patch:");
    enable(true);
    notesbox->settext(keep == nil ? "" : keep);
    notesdirty = keep != nil;   // the poll leaves them alone
    say("Connected to " + address + ".");
    trace("connected", address);
    poll();

    if (keep != nil) {
        savenotes();
    }
}

// label(a): how the list in the header shows the synth at address a: a
// Unix socket by its name (the synth's process id and number, "4711-1"),
// another address as it is.
label(a) {
    if (find(a, "unix://") == 0 && fs::ext(a) == ".sock") {
        local name = fs::base(a);
        return slice(name, 0, len(name) - 5);
    }
    return a;
}

// listsynths(): the synths in the list of the header: the sockets of
// running synths, and the one the GUI has.
listsynths() {
    local found = lmw::sockets(), items = [];

    if (_index(found, address) < 0) {
        push(found, address);
    }
    synths = {};

    for (local a in found) {
        local l = label(a);

        if (haskey(synths, l)) {   // two directories with the same name in them
            l = a;
        }
        synths[l] = a;
        push(items, l);
    }

    if (join(items, " ") != join(synthlist->items(), " ")) {
        synthlist->setitems(items);
        trace("synths", join(found, " "));
    }
}

quit() {
    flush();
    savenotes();
    allnotesoff();

    if (lister != nil) {
        lister->cancel();
    }

    if (flushing != nil) {
        flushing->cancel();
    }

    if (poller != nil) {
        poller->cancel();
    }

    if (!synth->closed()) {
        synth->close();
    }

    if (server != nil) {
        server->close();
    }
    return true;
}

// Patch files and notes (docs/future.md §13.5)

global PATCHTYPES = [["LMW-Synth patches", ".lmwpatch"], ["All files", "*"]];

// loadpatch(): a patch file chosen by the user, loaded into the synth
// (which checks it: its message goes to the status line).
loadpatch() {
    if (synth->closed()) {
        return;
    }
    local path = tk::openfile({"title": "Load a patch", "types": PATCHTYPES, "parent": window});

    if (path == nil) {
        return;
    }
    flush();
    savenotes();

    try {
        synth->load(readfile(path));
        say("Loaded " + path + ".");
        trace("loaded", fs::base(path));
    } catch (e) {
        failed(e);
        trace("refused", "patch", e->message);
    }
}

// savepatch(): the synth's patch, written to a file the user chooses.
savepatch() {
    if (synth->closed()) {
        return;
    }
    flush();
    savenotes();
    local name = patchtitle == "" ? "patch" : patchtitle;
    local path = tk::savefile({"title": "Save the patch", "types": PATCHTYPES, "ext": ".lmwpatch", "file": name + ".lmwpatch", "parent": window});

    if (path == nil) {
        return;
    }

    try {
        writefile(path, synth->patch());
        say("Saved " + path + ".");
        trace("saved", fs::base(path));
    } catch (e) {
        failed(e);
    }
}

// makenotes(page, chain): the Notes tab: the text is written a second
// after typing stops, and when it loses the keyboard.
makenotes(page, chain) {
    notesbox = new tk::Text(page, {"width": 80, "height": 20, "wrap": "word", "scroll": "y"});
    notesbox->pack({"fill": "both", "expand": true});

    if (verbose) {
        push(geometry, ["notes", extend(chain, cell(notesbox))]);
    }
    local typed = fn() {
        if (notesbox->text() != notestext) {
            notesdirty = true;

            if (notestimer != nil) {
                notestimer->cancel();
            }
            notestimer = events::after(1, savenotes);
        }
    };
    notesbox->bind("<KeyRelease>", fn(e) { typed(); });
    notesbox->bind("<ButtonRelease-2>", fn(e) { events::after(0, typed); });   // a paste comes after this
    notesbox->bind("<FocusOut>", fn(e) { savenotes(); });
}

// savenotes(): the notes, written when they differ from the synth's.
savenotes() {
    if (notestimer != nil) {
        notestimer->cancel();
        notestimer = nil;
    }

    if (notesbox == nil || synth->closed()) {
        return;
    }
    local t = notesbox->text();

    if (t == notestext) {
        notesdirty = false;
        return;
    }

    try {
        synth->setnotes(t);
        notestext = t;
        notesdirty = false;
        trace("write notes", len(t), "bytes");
    } catch (e) {
        failed(e);
    }
}

// shownotes(first): the synth's notes, shown unless the user has changes
// not yet written (they win: they are written next); first: at the first
// poll (no -v line).
shownotes(first) {
    local n = "";

    try {
        n = synth->notes();
    } catch (e) {
        return failed(e);
    }

    if (notesdirty || n == notestext) {
        return;
    }
    notestext = n;
    notesbox->settext(n);

    if (!first) {
        trace("show notes", len(n), "bytes");
    }
}

// The matrix (docs/future.md §13.5, the synth's MatrixView.cpp)

// makematrix(page, chain): the canvas of the Matrix tab, its rows and
// columns from /ports.
makematrix(page, chain) {
    local ports = synth->ports();

    for (local i in ports["inputs"]) {
        push(inputs, i["name"]);
        normalled[i["name"]] = i["normalled"];
    }
    outputs = ports["outputs"];
    matrix = new tk::Canvas(
        page,
        {"width": LABELW + len(outputs) * CELLW + 2, "height": HEADH + len(inputs) * CELLH + 2, "background": lmwtheme::WHITE},
    );
    matrix->pack();

    if (verbose) {
        push(geometry, ["matrix", extend(chain, cell(matrix))]);
        trace("matrix cells", LABELW, HEADH, CELLW, CELLH);
    }
    matrix->bind("<Button-1>", fn(e) {
        matrix->focus();
        local c = cellat(e["x"], e["y"]);
        drag = nil;

        if (c != nil && !synth->closed()) {
            cursor = c;
            drawcursor();
            drag = {"cell": c, "start": level(c), "y": e["y"], "moved": false};
            held["cable:" + inputs[c[0]]] = true;
        }
    });
    matrix->bind("<B1-Motion>", fn(e) {
        if (drag == nil || gate(inputs[drag["cell"][0]])) {
            return;
        }
        local dy = e["y"] - drag["y"];

        if (!drag["moved"] && abs(dy) < 3) {
            return;
        }
        drag["moved"] = true;
        setpin(drag["cell"], drag["start"] - dy / 150.0);   // 1 % per 1.5 pixels, up is more
    });
    matrix->bind("<ButtonRelease-1>", fn(e) {
        if (drag == nil) {
            return;
        }
        local c = drag["cell"], at = cellat(e["x"], e["y"]), key = "cable:" + inputs[c[0]];
        held[key] = false;
        touched[key] = clock() + SETTLE;

        if (!drag["moved"] && at != nil && at[0] == c[0] && at[1] == c[1]) {
            setpin(c, level(c) > 0 ? 0.0 : 1.0);
        }
        drag = nil;
    });
    matrix->bind("<Double-Button-1>", fn(e) {
        local c = cellat(e["x"], e["y"]);

        if (c != nil && !gate(inputs[c[0]]) && !synth->closed()) {
            asklevel(c);
        }
    });
    matrix->bind("<Motion>", fn(e) {
        local c = cellat(e["x"], e["y"]);

        if (c != nil) {
            say(describe(c));
        }
    });
    matrix->bind("<FocusIn>", fn(e) {
        focused = true;
        drawcursor();
    });
    matrix->bind("<FocusOut>", fn(e) {
        focused = false;
        drawcursor();
    });
    matrix->bind("<Key>", key);
}

// gate(input): whether an input is on or off only (an envelope's gate).
gate(input) {
    local dot = find(input, ".");
    return slice(input, dot + 1) == "gate";
}

// cellat(x, y): the cell [input index, output index] at a point of the
// canvas, or nil.
cellat(x, y) {
    if (x < LABELW || y < HEADH) {
        return nil;
    }
    local o = (x - LABELW) / CELLW, i = (y - HEADH) / CELLH;
    return i < len(inputs) && o < len(outputs) ? [i, o] : nil;
}

// level(c): the level of the cable of cell c, 0 for none.
level(c) {
    for (local p in _pinsof(cables, inputs[c[0]])) {
        if (p[0] == outputs[c[1]]) {
            return p[1];
        }
    }
    return 0.0;
}

// setpin(c, l): the cable of cell c at level l (whole percents; 0 takes
// it out; a gate's is on or off), shown at once and written (at most every
// THROTTLE, as a fader).
setpin(c, l) {
    local input = inputs[c[0]], output = outputs[c[1]];

    if (synth->closed()) {
        return;
    }
    l = max(0.0, min(1.0, round(l * 100) / 100.0));

    if (gate(input)) {
        l = l > 0 ? 1.0 : 0.0;
    }

    if (abs(l - level(c)) < 1e-6) {
        return;
    }
    local pins = [], found = false;

    for (local p in _pinsof(cables, input)) {
        if (p[0] == output) {
            found = true;

            if (l > 0) {
                push(pins, [output, l]);
            }
        } else {
            push(pins, p);
        }
    }

    if (!found && l > 0) {
        push(pins, [output, l]);   // a fifth is the synth's to refuse
    }
    setcable(input, pins);
}

// setcable(input, pins): an input's cables, shown at once and written (at
// most every THROTTLE, as a fader).
setcable(input, pins) {
    if (synth->closed()) {
        return;
    }
    cables[input] = pins;
    drawrow(_index(inputs, input));
    redrawschematic();
    local key = "cable:" + input;
    touched[key] = clock() + SETTLE;
    pending[key] = pins;

    if (flushing == nil) {
        flush();
    }
}

// key(e): the keys of the matrix (as the synth's).
key(e) {
    local k = e["key"], ch = e["char"], c = cursor;

    if (k == "Up" || k == "Down" || k == "Left" || k == "Right") {
        local di = k == "Up" ? -1 : k == "Down" ? 1 : 0, dout = k == "Left" ? -1 : k == "Right" ? 1 : 0;
        cursor = [max(0, min(len(inputs) - 1, c[0] + di)), max(0, min(len(outputs) - 1, c[1] + dout))];
        drawcursor();
    } else if (k == "space" || k == "Return") {
        setpin(c, level(c) > 0 ? 0.0 : 1.0);
    } else if (k == "Delete" || k == "BackSpace" || k == "End") {
        setpin(c, 0.0);
    } else if (k == "Home") {
        setpin(c, 1.0);
    } else if (k == "Prior" || k == "Next") {
        setpin(c, level(c) + (k == "Prior" ? 0.01 : -0.01));
    } else if (ch == "+" || ch == "=" || ch == "-" || ch == "_") {
        setpin(c, level(c) + (ch == "+" || ch == "=" ? 0.1 : -0.1));
    } else {
        return;
    }
    return false;   // the key is the matrix's
}

// describe(c): what cell c is, and what can be done with it.
describe(c) {
    local input = inputs[c[0]], output = outputs[c[1]], l = level(c), state = "no cable";

    if (l > 0) {
        state = "cable at " + str(round(l * 100)) + " %";
    } else if (len(_pinsof(cables, input)) == 0 && normalled[input] == output) {
        state = "normalled (used while this input has no cables)";
    }
    local how = gate(input) ? "Click: on/off." : "Click: on/off. Drag up/down: level. Double-click: type the level.";

    if (l == 0 && len(_pinsof(cables, input)) >= 4) {
        how = "This input already has 4 cables.";
    }
    return output + " → " + input + ": " + state + ". " + how;
}

// asklevel(c): a small window that asks for the level of cell c.
asklevel(c) {
    local w = new tk::Window("Cable level"), f = new tk::Frame(w, {"padding": 10});
    f->pack({"fill": "both", "expand": true});
    new tk::Label(f, outputs[c[1]] + " → " + inputs[c[0]] + "\nLevel in percent (0 removes the cable):")->pack();
    local entry = new tk::Entry(f, str(round(level(c) * 100)), {"width": 8, "justify": "center"});
    entry->pack({"pady": 6});
    local ok = fn(text) {
        local t = trim(replace(text, "%", "")), v = nil;

        try {
            v = float(t);
        } catch (e) {
        }

        if (v == nil || v < 0) {
            say("Not a level: " + text);
        } else {
            setpin(c, v / 100.0);
        }
        w->close();
    };
    entry->onenter(ok);
    local buttons = new tk::Frame(f);
    buttons->pack();
    new tk::Button(buttons, "OK")->onclick(fn() { ok(entry->text()); })->pack({"side": "left", "padx": 4});
    new tk::Button(buttons, "Cancel")->onclick(fn() { w->close(); })->pack({"side": "left", "padx": 4});
    w->bind("<Key-Escape>", fn(e) { w->close(); });
    entry->focus();
}

// The drawing: tags h (heads and labels), r<i> (the cells of row i), grid
// and cursor.

_box(i, o) {
    local x = LABELW + o * CELLW, y = HEADH + i * CELLH;
    return [x, y, x + CELLW, y + CELLH];
}

_module(port) {
    return slice(port, 0, find(port, "."));
}

// ink(): the colour the matrix is drawn in: black, or while the synth is
// lost the colour of disabled text (black too at Max).
ink() {
    return connected ? lmwtheme::BLACK : theme["tk"]["disabled"];
}

// drawmatrix(): all of it (at the start, and for new colours).
drawmatrix() {
    if (matrix == nil || theme == nil) {
        return;
    }
    matrix->clear();
    local units = theme["units"], black = ink();
    local right = LABELW + len(outputs) * CELLW, bottom = HEADH + len(inputs) * CELLH;

    for (local o = 0; o < len(outputs); o++) {
        local x = LABELW + o * CELLW, name = outputs[o], dot = find(name, ".");
        matrix->rect(x, 0, x + CELLW, HEADH, {"fill": units[lmwtheme::unit(name)], "outline": ""});
        matrix->text(x + CELLW / 2, HEADH / 2 - 1, slice(name, 0, dot), {"anchor": "s", "color": black, "font": {"bold": true, "size": 9}});
        matrix->text(x + CELLW / 2, HEADH / 2 + 1, slice(name, dot + 1), {"anchor": "n", "color": black, "font": {"bold": true, "size": 9}});
    }

    for (local i = 0; i < len(inputs); i++) {
        local y = HEADH + i * CELLH, name = inputs[i];
        matrix->rect(0, y, LABELW, y + CELLH, {"fill": units[lmwtheme::unit(name)], "outline": ""});
        matrix->text(LABELW - 6, y + CELLH / 2, name + (gate(name) ? " (on/off)" : ""), {"anchor": "e", "color": black, "font": {"size": 9}});
    }

    for (local o = 0; o <= len(outputs); o++) {   // thin lines, thick between modules
        local x = LABELW + o * CELLW;
        local edge = o == 0 || o == len(outputs) || _module(outputs[o]) != _module(outputs[o - 1]);
        matrix->line([x, edge ? 0 : HEADH, x, bottom], {"color": black, "width": edge ? 2 : 1});
    }

    for (local i = 0; i <= len(inputs); i++) {
        local y = HEADH + i * CELLH;
        local edge = i == 0 || i == len(inputs) || _module(inputs[i]) != _module(inputs[i - 1]);
        matrix->line([edge ? 0 : LABELW, y, right, y], {"color": black, "width": edge ? 2 : 1});
    }

    for (local i = 0; i < len(inputs); i++) {
        drawrow(i);
    }
    drawcursor();
}

// drawrow(i): the cells of row i: a cable as its level in % over a bar
// filled to it; the normalled source of an input without cables as a
// ring.
drawrow(i) {
    if (matrix == nil || theme == nil || i < 0) {
        return;
    }
    local tag = "r" + str(i), black = ink(), input = inputs[i];
    matrix->remove(tag);
    local items = [];

    for (local o = 0; o < len(outputs); o++) {
        local b = _box(i, o), l = level([i, o]);
        local x1 = b[0] + 3, y1 = b[1] + 2, x2 = b[2] - 3, y2 = b[3] - 2;

        if (l > 0) {
            push(items, matrix->rect(x1, y1, x2, y2, {"outline": black, "width": 1}));
            push(items, matrix->rect(x1, y2 - 3, x1 + max(2, round((x2 - x1) * l)), y2, {"fill": black, "outline": ""}));
            push(items, matrix->text((x1 + x2) / 2, y1, str(round(l * 100)) + " %", {"anchor": "n", "color": black, "font": {"size": 8}}));
        } else if (len(_pinsof(cables, input)) == 0 && normalled[input] == outputs[o]) {
            local cx = (b[0] + b[2]) / 2, cy = (b[1] + b[3]) / 2;
            push(items, matrix->oval(cx - 5, cy - 5, cx + 5, cy + 5, {"outline": black, "width": 2}));
        }
    }

    for (local id in items) {
        matrix->tag(id, tag);
    }
    matrix->raise("cursor");
}

// drawcursor(): the cell cursor, while the matrix has the keyboard.
drawcursor() {
    if (matrix == nil) {
        return;
    }
    matrix->remove("cursor");

    if (focused) {
        local b = _box(cursor[0], cursor[1]);
        matrix->tag(matrix->rect(b[0] + 1, b[1] + 1, b[2] - 1, b[3] - 1, {"outline": ink(), "width": 3}), "cursor");
    }
}

// The schematic (docs/future.md §13.5; the synth's S6.7)

// makeschematic(page, chain): the canvas of the Schematic tab.
makeschematic(page, chain) {
    schem = new tk::Canvas(
        page,
        {
            "width": round(lmwschematic::WIDTH * SCALE) + 2 * MARGIN, "height": round(lmwschematic::HEIGHT * SCALE) + 2 * MARGIN,
            "background": lmwtheme::WHITE,
        },
    );
    schem->pack();

    if (verbose) {
        push(geometry, ["schematic", extend(chain, cell(schem))]);
    }
    schem->bind("<Button-1>", fn(e) {
        schem->focus();
        local p = sportat(e["x"], e["y"], "");
        sdrag = nil;

        if (p == nil || synth->closed()) {
            return;
        }
        scursor = _index(lmwschematic::order(), p);
        local pins = _pinsof(cables, p);

        if (lmwschematic::isinput(p) && len(pins) > 0) {   // its newest cable
            local last = pins[len(pins) - 1];
            sdrag = {"from": p, "grab": true, "output": last[0], "level": last[1], "x": e["x"], "y": e["y"], "moved": false};
        } else {
            sdrag = {"from": p, "grab": false, "x": e["x"], "y": e["y"], "moved": false};
        }
        drawschematic();
    });
    schem->bind("<B1-Motion>", fn(e) {
        if (sdrag == nil) {
            return;
        }

        if (!sdrag["moved"] && abs(e["x"] - sdrag["x"]) + abs(e["y"] - sdrag["y"]) < 4) {
            return;
        }
        sdrag["moved"] = true;
        sdrag["x"] = e["x"];
        sdrag["y"] = e["y"];
        sdrag["target"] = droptarget(sdrag, e["x"], e["y"]);
        drawdrag();
    });
    schem->bind("<ButtonRelease-1>", fn(e) {
        if (sdrag == nil) {
            return;
        }
        local d = sdrag;
        sdrag = nil;

        if (d["moved"]) {
            drop(d, droptarget(d, e["x"], e["y"]));
        }
        drawschematic();
    });
    schem->bind("<Button-3>", fn(e) {
        local p = sportat(e["x"], e["y"], "");

        if (p != nil && !synth->closed()) {
            scursor = _index(lmwschematic::order(), p);
            drawschematic();
            cablemenu(p, e["xroot"], e["yroot"]);
        }
    });
    schem->bind("<Motion>", fn(e) {
        local p = sportat(e["x"], e["y"], "");

        if (p != nil) {
            say(describeport(p));
            return;
        }
        local b = lmwschematic::blockat(slayout, (e["x"] - MARGIN) / SCALE, (e["y"] - MARGIN) / SCALE);

        if (b >= 0) {
            say(describeblock(b));
        }
    });
    schem->bind("<FocusIn>", fn(e) {
        sfocused = true;
        drawschematic();
    });
    schem->bind("<FocusOut>", fn(e) {
        sfocused = false;
        drawschematic();
    });
    schem->bind("<Key>", schemkey);
}

// keyfader(id, v): the Key faders of the filters, for the key-tracking
// links.
keyfader(id, v) {
    if (haskey(keyamount, id) && typeof(v) != "string") {
        local changed = abs(keyamount[id] - v) > 1e-9;
        keyamount[id] = float(v);

        if (changed) {
            redrawschematic();
        }
    }
}

// showlayout(section): the blocks where the synth's [schematic] has them.
showlayout(section) {
    slayout = lmwschematic::layout(section);
    trace("schematic moved", lmwschematic::moved(slayout));

    if (verbose) {
        for (local p in lmwschematic::order()) {
            local q = spixels(lmwschematic::point(slayout, p));
            trace("port", p, round(q[0]), round(q[1]));
        }
    }
    drawschematic();
}

// spixels(p): a point of the schematic in units, on the canvas in pixels.
spixels(p) {
    return [MARGIN + p[0] * SCALE, MARGIN + p[1] * SCALE];
}

// sportat(x, y, want): the port at a point of the canvas ("input",
// "output" or "" for either), or nil.
sportat(x, y, want) {
    if (slayout == nil) {
        return nil;
    }
    return lmwschematic::portat(slayout, (x - MARGIN) / SCALE, (y - MARGIN) / SCALE, 1.3, want);
}

// droptarget(d, x, y): where drag d would go at a point: for a new cable
// a port of the other kind, for a cable picked up another input; or nil.
droptarget(d, x, y) {
    if (d["grab"]) {
        local p = sportat(x, y, "input");
        return p == d["from"] ? nil : p;
    }
    return sportat(x, y, lmwschematic::isinput(d["from"]) ? "output" : "input");
}

// drop(d, target): the end of a drag: a new cable between its port and
// target, or a picked-up cable moved to target (keeping its level) or,
// dropped elsewhere, taken out.
drop(d, target) {
    if (!d["grab"]) {
        if (target != nil) {
            local input = lmwschematic::isinput(target) ? target : d["from"], output = input == target ? d["from"] : target;
            addpin(input, output, 1.0);
        }
        return;
    }
    removepin(d["from"], d["output"]);

    if (target != nil) {
        addpin(target, d["output"], d["level"]);
    }
}

// addpin(input, output, level), removepin(input, output): one cable in or
// out (a cable already there keeps its level; a fifth is the synth's to
// refuse).
addpin(input, output, level) {
    local pins = [];

    for (local p in _pinsof(cables, input)) {
        if (p[0] == output) {
            return;
        }
        push(pins, p);
    }
    push(pins, [output, level]);
    setcable(input, pins);
}

removepin(input, output) {
    local pins = [];

    for (local p in _pinsof(cables, input)) {
        if (p[0] != output) {
            push(pins, p);
        }
    }
    setcable(input, pins);
}

// _feeds(output): the inputs with a cable from output.
_feeds(output) {
    local out = [];

    for (local input in inputs) {
        for (local p in _pinsof(cables, input)) {
            if (p[0] == output) {
                push(out, input);
            }
        }
    }
    return out;
}

// cablemenu(port, x, y): the port's menu at x, y on the screen, as the
// synth's: an input's sources or an output's inputs to tick, taking cables
// out; only what can be done.
cablemenu(port, x, y) {
    local m = new tk::Menu(window, {"popup": true}), plugged = false;

    for (local i in inputs) {
        if (len(_pinsof(cables, i)) > 0) {
            plugged = true;
        }
    }

    if (lmwschematic::isinput(port)) {
        local sub = m->submenu("Connect from"), pins = _pinsof(cables, port);

        for (local o in outputs) {
            local on = _index(_feeds(o), port) >= 0;

            if (on || len(pins) < 4) {
                local output = o;
                sub->check(o, fn(checked) { checked ? addpin(port, output, 1.0) : removepin(port, output); }, on);
            }
        }

        if (len(pins) > 0) {
            m->item("Remove all cables here", fn() { setcable(port, []); });
        }
    } else {
        local sub = m->submenu("Connect to"), fed = _feeds(port);

        for (local i in inputs) {
            local on = _index(fed, i) >= 0;

            if (on || len(_pinsof(cables, i)) < 4) {
                local input = i;
                sub->check(i, fn(checked) { checked ? addpin(input, port, 1.0) : removepin(input, port); }, on);
            }
        }

        if (len(fed) > 0) {
            m->item("Remove cables from here", fn() {
                for (local i in fed) {
                    removepin(i, port);
                }
            });
        }
    }

    if (plugged) {
        m->separator();
        m->item("Remove all cables", fn() {
            for (local i in inputs) {
                if (len(_pinsof(cables, i)) > 0) {
                    setcable(i, []);
                }
            }
        });
    }
    m->popup(x, y);
}

// schemkey(e): the keys of the schematic (as the synth's): Left and Right
// move the port cursor, Down and Up to the next or previous block; Enter
// or Shift+F10 opens the port's menu; Delete or BackSpace takes an input's
// cables out; Escape cancels a drag. (Tk gives no Shift with the key, so
// F10 alone opens the menu too.)
schemkey(e) {
    local k = e["key"], ports = lmwschematic::order(), n = len(ports), p = ports[scursor];

    if (k == "Escape" && sdrag != nil) {
        sdrag = nil;
    } else if (k == "Right" || k == "Left") {
        scursor = (scursor + (k == "Right" ? 1 : n - 1)) % n;
    } else if (k == "Down" || k == "Up") {
        scursor = lmwschematic::jump(scursor, k == "Down" ? 1 : -1);
    } else if (k == "Return" || k == "F10") {
        if (!synth->closed()) {
            local q = spixels(lmwschematic::point(slayout, p));
            cablemenu(p, e["xroot"] - e["x"] + round(q[0]), e["yroot"] - e["y"] + round(q[1]));
        }
        return false;
    } else if ((k == "Delete" || k == "BackSpace") && lmwschematic::isinput(p)) {
        setcable(p, []);
    } else {
        return;
    }
    drawschematic();
    say(describeport(ports[scursor]));
    return false;   // the key is the schematic's
}

// describeport(p), describeblock(i): the hover texts.
describeport(p) {
    if (lmwschematic::isinput(p)) {
        local hint = len(_pinsof(cables, p)) > 0 ? " Drag: move or take out the newest cable." : " Drag to an output: a cable.";
        return lmwschematic::describeinput(p, cables, normalled) + "." + hint + " Right click or Enter: menu.";
    }
    return lmwschematic::describeoutput(p, cables, normalled) + ". Drag to an input: a cable. Right click or Enter: menu.";
}

describeblock(i) {
    local b = lmwschematic::BLOCKS[i], parts = [];

    for (local kind in ["inputs", "outputs"]) {
        for (local p in b[kind]) {
            push(parts, kind == "inputs" ? lmwschematic::describeinput(p, cables, normalled) : lmwschematic::describeoutput(p, cables, normalled));
        }
    }
    local note = lmwschematic::blocknote(b["name"], keyamount["vcf1.key"], keyamount["vcf2.key"]);

    if (note != "") {
        push(parts, note);
    }
    return b["name"] + ": " + join(parts, "; ");
}

// redrawschematic(): draws the schematic once the handler that changed it
// is done (a poll may change several inputs).
redrawschematic() {
    if (!sdrawing) {
        sdrawing = true;
        events::post(fn() {
            sdrawing = false;
            drawschematic();
        });
    }
}

// _line(c, options): a curve of the schematic (units) as a canvas line.
_line(c, options) {
    return schem->line(lmwschematic::points(c, 16, SCALE, MARGIN, MARGIN), options);
}

// drawschematic(): all of it: the normalled connections dashed behind the
// blocks; the blocks in their unit's colour with their ports; the internal
// links dotted; the cables black with a white edge on top, with their level
// below 100 %; the legend; the port cursor and a cable being dragged.
drawschematic() {
    if (schem == nil || theme == nil || slayout == nil) {
        return;
    }
    schem->clear();
    local black = ink(), l = slayout, hide = sdrag != nil && sdrag["grab"] ? sdrag : nil;
    local conns = lmwschematic::connections(cables, normalled);

    for (local c in conns) {
        if (c["normalled"]) {
            local a = lmwschematic::point(l, c["from"]), b = lmwschematic::point(l, c["to"]);
            _line(lmwschematic::curve(a, b), {"color": black, "width": 1, "dash": [5, 4]});
        }
    }

    for (local i = 0; i < len(lmwschematic::BLOCKS); i++) {
        drawblock(i, black);
    }

    for (local k in lmwschematic::links(keyamount["vcf1.key"], keyamount["vcf2.key"])) {
        local a = lmwschematic::point(l, k["from"]), t = lmwschematic::target(l, lmwschematic::findblock(k["block"]));
        _line(lmwschematic::linkcurve(a, t), {"color": black, "width": 1, "dash": [2, 3], "arrow": "last"});
        local q = spixels(t);
        schem->text(q[0] + 4, q[1] + 6, k["label"], {"anchor": "nw", "color": black, "font": {"size": 7}});
    }

    for (local c in conns) {
        if (c["normalled"] || hide != nil && c["to"] == hide["from"] && c["from"] == hide["output"]) {
            continue;
        }
        local curve = lmwschematic::curve(lmwschematic::point(l, c["from"]), lmwschematic::point(l, c["to"]));
        _line(curve, {"color": lmwtheme::WHITE, "width": 5});
        _line(curve, {"color": black, "width": 2});

        if (c["level"] < 1) {
            local q = spixels(lmwschematic::at(curve, 0.5));
            schem->rect(q[0] - 15, q[1] - 7, q[0] + 15, q[1] + 7, {"fill": lmwtheme::WHITE, "outline": black});
            schem->text(q[0], q[1], lmwschematic::percent(c["level"]), {"color": black, "font": {"size": 7}});
        }
    }
    drawlegend(black);

    if (sfocused) {
        local q = spixels(lmwschematic::point(l, lmwschematic::order()[scursor])), r = 1.3 * SCALE;
        schem->rect(q[0] - r, q[1] - r, q[0] + r, q[1] + r, {"outline": black, "width": 2});
    }
    drawdrag();
}

// drawblock(i, black): a block: its symbol in its unit's colour, its name,
// its ports (an input white with a black ring, black in the middle when
// it has a cable; an output black with a white ring) and their names when
// it has several.
drawblock(i, black) {
    local b = lmwschematic::BLOCKS[i], r = lmwschematic::box(slayout, i), shape = b["shape"];
    local x = MARGIN + r[0] * SCALE, y = MARGIN + r[1] * SCALE, w = r[2] * SCALE, h = r[3] * SCALE;
    local fill = theme["units"][lmwtheme::unit(b["name"])], bold = {"bold": true, "size": 8}, small = {"size": 7};

    if (shape == "triangle") {
        schem->polygon([x, y, x, y + h, x + w, y + h / 2], {"fill": fill, "outline": black, "width": 2});
        local n = len(b["inputs"]), ny = y + h / 2;   // the name in the middle, or between the first two inputs

        if (n == 3) {
            ny = y + h * 1.5 / 4;
        }
        schem->text(x + 0.9 * SCALE, ny, b["name"], {"anchor": "w", "color": black, "font": bold});
    } else if (shape == "out") {
        local d = min(w, h) * 0.8, cx = x + w * 0.45, cy = y + h / 2;
        schem->oval(cx - d / 2, cy - d / 2, cx + d / 2, cy + d / 2, {"fill": fill, "outline": black, "width": 2});
        schem->line([cx + d / 2, cy, x + w, cy], {"color": black, "width": 2, "arrow": "last"});
        schem->text(cx, cy, b["name"], {"color": black, "font": {"bold": true, "size": 7}});
    } else {
        schem->rect(x, y, x + w, y + h, {"fill": fill, "outline": black, "width": 2});
        schem->text(x + w / 2, y + 2, b["name"], {"anchor": "n", "color": black, "font": bold});
        drawpicture(shape, x, y, w, h, black);
    }

    for (local kind in ["inputs", "outputs"]) {
        local ports = b[kind];

        for (local p in ports) {
            local q = spixels(lmwschematic::point(slayout, p)), rad = 0.7 * SCALE;

            if (kind == "inputs") {
                schem->oval(q[0] - rad, q[1] - rad, q[0] + rad, q[1] + rad, {"fill": lmwtheme::WHITE, "outline": black, "width": 2});

                if (len(_pinsof(cables, p)) > 0) {
                    schem->oval(q[0] - 2, q[1] - 2, q[0] + 2, q[1] + 2, {"fill": black, "outline": black});
                }
            } else {
                schem->oval(q[0] - rad, q[1] - rad, q[0] + rad, q[1] + rad, {"fill": black, "outline": black});
                schem->oval(q[0] - rad + 2, q[1] - rad + 2, q[0] + rad - 2, q[1] + rad - 2, {"outline": lmwtheme::WHITE, "width": 1});
            }

            if (len(ports) > 1) {
                local lx = kind == "inputs" ? q[0] + 0.9 * SCALE : q[0] - 0.9 * SCALE;
                schem->text(lx, q[1], lmwschematic::label(p), {"anchor": kind == "inputs" ? "w" : "e", "color": black, "font": small});
            }
        }
    }
}

// drawpicture(shape, x, y, w, h, black): the picture under a box's name:
// an ADSR curve, a white-noise trace, a small keyboard.
drawpicture(shape, x, y, w, h, black) {
    if (shape == "adsr") {
        local base = y + h * 0.88, top = y + h * 0.38, hold = y + h * 0.6;
        schem->line(
            [x + w * 0.12, base, x + w * 0.3, top, x + w * 0.45, hold, x + w * 0.7, hold, x + w * 0.88, base],
            {"color": black, "width": 2},
        );
    } else if (shape == "noise") {
        local pts = [], mid = y + h * 0.65, ups = [0.2, -0.7, 0.5, -0.3, 0.9, -0.9, 0.3, -0.5, 0.7, -0.2, 0.6, -0.8, 0.1];

        for (local i = 0; i < len(ups); i++) {
            push(pts, x + w * (0.08 + 0.5 * i / (len(ups) - 1)), mid + ups[i] * h * 0.22);
        }
        schem->line(pts, {"color": black, "width": 1});
    } else if (shape == "keys") {
        local kw = w * 0.12, top = y + h * 0.36, bottom = y + h * 0.9, left = x + w * 0.08;

        for (local k = 0; k < 4; k++) {
            schem->rect(left + k * kw, top, left + (k + 1) * kw, bottom, {"fill": lmwtheme::WHITE, "outline": black, "width": 1});
        }
        schem->rect(left + kw * 0.65, top, left + kw * 1.35, top + (bottom - top) * 0.6, {"fill": black, "outline": black});
    }
}

// drawlegend(black): what the three kinds of line mean, at the bottom.
drawlegend(black) {
    local y = MARGIN + (lmwschematic::HEIGHT - 2) * SCALE, x = MARGIN + 2 * SCALE, span = 6 * SCALE;
    local kinds = [
        [{"color": black, "width": 1, "dash": [5, 4]}, "normalled (used while the input has no cables)"],
        [{"color": black, "width": 2}, "cable (its level when below 100 %)"],
        [{"color": black, "width": 1, "dash": [2, 3], "arrow": "last"}, "internal link (set by a fader)"],
    ];

    for (local k in kinds) {
        schem->line([x, y, x + span, y], k[0]);
        schem->text(x + span + 6, y, k[1], {"anchor": "w", "color": black, "font": {"size": 8}});
        x += span + 6 + 40 * SCALE;
    }
}

// drawdrag(): a cable being dragged: its loose end at the mouse, a ring
// around the port it would go to.
drawdrag() {
    if (schem == nil) {
        return;
    }
    schem->remove("drag");

    if (sdrag == nil || !sdrag["moved"]) {
        return;
    }
    local black = ink(), m = [(sdrag["x"] - MARGIN) / SCALE, (sdrag["y"] - MARGIN) / SCALE], c = nil;

    if (sdrag["grab"]) {
        c = lmwschematic::curve(lmwschematic::point(slayout, sdrag["output"]), m);
    } else if (lmwschematic::isinput(sdrag["from"])) {
        c = lmwschematic::curve(m, lmwschematic::point(slayout, sdrag["from"]));
    } else {
        c = lmwschematic::curve(lmwschematic::point(slayout, sdrag["from"]), m);
    }
    local items = [_line(c, {"color": lmwtheme::WHITE, "width": 5}), _line(c, {"color": black, "width": 2})];

    if (sdrag["target"] != nil) {
        local q = spixels(lmwschematic::point(slayout, sdrag["target"])), r = 1.2 * SCALE;
        push(items, schem->oval(q[0] - r, q[1] - r, q[0] + r, q[1] + r, {"outline": black, "width": 2}));
    }

    for (local id in items) {
        schem->tag(id, "drag");
    }
}

// The keyboard (the synth's /keys)

// white(n): whether note n is a white key.
white(n) {
    return _index([0, 2, 4, 5, 7, 9, 11], n % 12) >= 0;
}

// keybox(n): the rectangle of note n's key on the canvas.
keybox(n) {
    local whites = 0;

    for (local m = LOWNOTE; m < n; m++) {
        if (white(m)) {
            whites++;
        }
    }

    if (white(n)) {
        return [1 + whites * KEYW, 1, 1 + (whites + 1) * KEYW, 1 + KEYH];
    }
    local x = 1 + whites * KEYW;
    return [x - BLACKW / 2, 1, x + BLACKW - BLACKW / 2, 1 + BLACKH];
}

// keyat(x, y): [note, velocity] of the point on the canvas, or nil: a
// black key first (they lie on top); soft at the top, loud at the bottom.
keyat(x, y) {
    for (local pass = 0; pass < 2; pass++) {
        for (local n = LOWNOTE; n <= HIGHNOTE; n++) {
            local b = keybox(n);

            if (white(n) == (pass == 1) && x >= b[0] && x < b[2] && y >= b[1] && y < b[3]) {
                return [n, max(1, min(127, round(1 + 126.0 * (y - b[1]) / (b[3] - b[1]))))];
            }
        }
    }
    return nil;
}

// notename(n): "C4" for 60.
notename(n) {
    local names = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
    return names[n % 12] + str(n / 12 - 1);
}

makepiano(parent) {
    local whites = 0;

    for (local n = LOWNOTE; n <= HIGHNOTE; n++) {
        if (white(n)) {
            whites++;
        }
    }
    piano = new tk::Canvas(parent, {"width": whites * KEYW + 2, "height": KEYH + 2, "background": lmwtheme::WHITE});
    piano->pack({"pady": 2});

    if (verbose) {
        push(geometry, ["keyboard", [cell(piano)]]);
    }
    piano->bind("<Button-1>", fn(e) {
        piano->focus();
        local k = keyat(e["x"], e["y"]);

        if (k != nil) {
            mousekey = k[0];
            noteon(k[0], k[1]);
        }
    });
    piano->bind("<B1-Motion>", fn(e) {
        local k = keyat(e["x"], e["y"]);

        if (k != nil && k[0] != mousekey) {   // glides over the keys
            if (mousekey != nil) {
                noteoff(mousekey);
            }
            mousekey = k[0];
            noteon(k[0], k[1]);
        }
    });
    piano->bind("<ButtonRelease-1>", fn(e) {
        if (mousekey != nil) {
            noteoff(mousekey);
            mousekey = nil;
        }
    });
    piano->bind("<KeyPress>", keypress);
    piano->bind("<KeyRelease>", keyrelease);
    piano->bind("<FocusIn>", fn(e) {
        pianofocus = true;
        drawpiano();
    });
    piano->bind("<FocusOut>", fn(e) {   // a key let go elsewhere never comes here
        pianofocus = false;

        for (local c, n in typed) {
            noteoff(n);
        }
        typed = {};
        drawpiano();
    });
}

// keychar(e): the character of a key event's key ("" for none): by its
// name, since Tk gives no character for a release.
keychar(e) {
    local k = e["key"] == nil ? "" : e["key"];

    if (k == "semicolon") {
        return ";";
    }
    return len(k) == 1 ? lower(k) : "";
}

// keypress(e), keyrelease(e): the computer keys. X repeats a held key as
// a release and a press at once: a release waits a moment, and a press
// of the same key in that moment cancels it.
keypress(e) {
    local c = keychar(e);

    if (c == "z" || c == "x") {
        shift = max(-3, min(2, shift + (c == "z" ? -1 : 1)));
        say("The computer keys play from C" + str(4 + shift) + ".");
        return false;
    }
    local i = c == "" ? -1 : find(QWERTY, c);

    if (i < 0) {
        return;
    }

    if (releases[c] != nil) {   // a repeat
        releases[c]->cancel();
        releases = _without(releases, c);
        return false;
    }

    if (typed[c] == nil) {
        typed[c] = 60 + 12 * shift + i;
        noteon(typed[c], 100);
    }
    return false;
}

keyrelease(e) {
    local c = keychar(e);

    if (typed[c] == nil) {
        return;
    }
    releases[c] = events::after(0.04, fn() {
        releases = _without(releases, c);

        if (typed[c] != nil) {
            noteoff(typed[c]);
            typed = _without(typed, c);
        }
    });
    return false;
}

// noteon(n, velocity), noteoff(n): a note to the synth, and the key drawn
// pressed or not.
noteon(n, velocity) {
    if (synth->closed() || n < LOWNOTE || n > HIGHNOTE || down[n] != nil) {
        return;
    }

    try {
        synth->noteon(n, velocity);
        down[n] = true;
        trace("play on", n, velocity);
    } catch (e) {
        failed(e);
    }
    drawpiano();
}

noteoff(n) {
    if (down[n] == nil) {
        return;
    }
    down = _without(down, n);

    if (!synth->closed()) {
        try {
            synth->noteoff(n);
            trace("play off", n);
        } catch (e) {
            failed(e);
        }
    }
    drawpiano();
}

// allnotesoff(): every note the GUI plays, off (before it quits or goes to
// another synth).
allnotesoff() {
    for (local n, _ in down) {
        noteoff(n);
    }
    typed = {};
    mousekey = nil;
}

// drawpiano(): the keys: white and black, a pressed one in the pressed
// colours, the C keys named; a ring while it has the keyboard.
drawpiano() {
    if (piano == nil || theme == nil) {
        return;
    }
    piano->clear();
    local k = theme["keys"], line = ink();

    for (local pass = 0; pass < 2; pass++) {   // the white keys first: the black lie on them
        for (local n = LOWNOTE; n <= HIGHNOTE; n++) {
            if (white(n) != (pass == 0)) {
                continue;
            }
            local b = keybox(n), on = down[n] != nil;

            if (white(n)) {
                piano->rect(b[0], b[1], b[2], b[3], {"fill": on ? k["white"] : lmwtheme::WHITE, "outline": line});

                if (n % 12 == 0) {
                    piano->text((b[0] + b[2]) / 2, b[3] - 2, notename(n), {"anchor": "s", "color": on ? k["name"] : line, "font": {"size": 7}});
                }
            } else {
                piano->rect(b[0], b[1], b[2], b[3], {"fill": on ? k["black"] : line, "outline": line});
            }
        }
    }

    if (pianofocus) {
        local last = keybox(HIGHNOTE);
        piano->rect(1, 1, last[2], last[3], {"outline": line, "width": 2});
    }
}

// Contrast (docs/future.md §13.7)

// setcontrast(p, r, save): the colours of preset p (r: the ratio for
// "Custom", a number or its text); with save, kept in the settings file.
setcontrast(p, r, save) {
    local minimum = 0.0;

    try {
        minimum = lmwtheme::ratio(p, typeof(r) == "string" ? float(trim(r)) : r);
    } catch (e) {
        say("Contrast: " + e->message);
        return;
    }
    theme = lmwtheme::palette(minimum);
    tk::setcolors(theme["tk"]);
    drawmatrix();
    drawschematic();
    drawpiano();

    for (local t in titles) {
        t[0]->configure({"background": theme["units"][t[1]], "foreground": lmwtheme::BLACK});
    }
    preset = p;
    ratio = minimum;
    contrast->settext(p);
    customratio->settext(str(minimum));
    customratio->configure({"state": p == "Custom" ? "normal" : "disabled"});
    trace("contrast", p, minimum);

    if (save) {
        saveconfig();
    }
}

// The settings file: [contrast] preset = "AA", ratio = 4.5.

readconfig() {
    if (configpath == nil) {
        local dir = getenv("XDG_CONFIG_HOME");

        if (dir == nil || dir == "") {
            dir = getenv("APPDATA");
        }

        if (dir == nil || dir == "") {
            dir = fs::join(getenv("HOME") == nil ? "." : getenv("HOME"), ".config");
        }
        configpath = fs::join(dir, "lmw-gui.toml");
    }

    if (!fs::exists(configpath)) {
        return;
    }

    try {
        local c = toml::decode(readfile(configpath))["contrast"];

        if (c != nil) {
            local p = c["preset"] == nil ? "AA" : c["preset"], r = c["ratio"] == nil ? 4.5 : c["ratio"];
            ratio = lmwtheme::ratio(p, r);
            preset = p;
        }
    } catch (e) {
        eprintln("lmwgui:", configpath + ":", e->message, "(the contrast is AA)");
    }
}

saveconfig() {
    try {
        fs::mkdirall(fs::dir(configpath));
        writefile(configpath, toml::encode({"contrast": {"preset": preset, "ratio": ratio}}));
    } catch (e) {
        say("Cannot save the settings: " + e->message);
    }
}
