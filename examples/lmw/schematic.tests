# Tests of schematic.kkl and so of the module lmwschematic (the
# Schematic tab of lmwgui), run in examples/lmw.

# Where each port is at the default layout (canvas units)
$ ports
lfo1.out out 12.0 10.5
keys.pitch out 14.0 25.3
keys.gate out 14.0 27.5
keys.vel out 14.0 29.8
vco1.pitch in  26.0 7.3
vco1.fm in  26.0 10.7
vco1.out out 37.0 9.0
vco2.pitch in  26.0 21.3
vco2.fm in  26.0 24.7
vco2.out out 37.0 23.0
vco3.pitch in  26.0 35.3
vco3.fm in  26.0 38.7
vco3.out out 37.0 37.0
noise.out out 37.0 56.7
noise.rand out 37.0 59.3
mix.in1 in  48.0 19.2
mix.in2 in  48.0 24.4
mix.in3 in  48.0 29.6
mix.in4 in  48.0 34.8
mix.out out 60.0 27.0
vcf1.in in  68.0 23.5
vcf1.cutoff in  68.0 27.0
vcf1.res in  68.0 30.5
vcf1.out out 80.0 27.0
vcf2.in in  88.0 23.5
vcf2.cutoff in  88.0 27.0
vcf2.res in  88.0 30.5
vcf2.out out 100.0 27.0
vca.in in  108.0 23.5
vca.cv in  108.0 27.0
vca.mod in  108.0 30.5
vca.out out 120.0 27.0
out.in in  126.0 27.0
env1.gate in  50.0 62.0
env1.out out 62.0 62.0
env2.gate in  50.0 49.0
env2.out out 62.0 49.0
lfo2.out out 106.0 54.5

# [schematic] as the synth reads it: moved blocks; an unknown block, a bad position or a block that does not fit gives the default
$ layout
moved 0
vcf1.cutoff at 68.0 27.0

$ layout vcf1=70,40 lfo2=110,50
moved 2
vcf1 70 40
lfo2 110 50
vcf1.cutoff at 70.0 47.0

$ layout vcf1=69,20
moved 1
vcf1 69 20
vcf1.cutoff at 69.0 27.0

$ layout bogus=1,1
moved 0
vcf1.cutoff at 68.0 27.0

$ layout vca=1
moved 0
vcf1.cutoff at 68.0 27.0

$ layout vca=-1,20
moved 0
vcf1.cutoff at 68.0 27.0

$ layout out=130,22
moved 0
vcf1.cutoff at 68.0 27.0

$ layout vcf1=80,20
moved 0
vcf1.cutoff at 68.0 27.0

$ layout lfo2=96,64
moved 0
vcf1.cutoff at 68.0 27.0

# Hover texts, connections and internal links of a patch with a few cables
$ describe
lfo1.out (50 %) + env2.out → vcf1.cutoff (cables, summed)
lfo1.out (25 %) → vca.mod (cable)
vcf1.res: not connected
noise.out → mix.in4 (normalled)
lfo1.out → vco1.fm (normalled)
lfo1.out → vco1.fm (normalled), vco2.fm (normalled), vco3.fm (normalled), vcf1.cutoff (50 %), vca.mod (25 %)
env2.out → vcf1.cutoff, vcf2.cutoff (normalled)
lfo2.out → nothing
keys.vel → nothing
VCO 2: mod wheel → FM depth (internal: FM fader + wheel × 1 st)
VCF 1: keys.pitch → cutoff (internal: Key 50 %)
VCF 2: key tracking off (Key 0 %)
VCA: keys.vel → gain (internal, always: the VCA multiplies by velocity)
MIX: 
link keys.pitch → VCF 1 key 50 % at 71.6 31.9
link keys.vel → VCA velocity at 111.6 31.9
connections 21 normalled 18
at 68,24.5: vcf1.in nil
at 100,27: vcf2.out block VCF 1
curve lfo1.out → vcf1.cutoff, middle 40.0 18.8 pieces 16

# The port cursor: Down and Up go to the next or previous block
$ jump
38 ports
lfo1.out down keys.pitch up lfo2.out
keys.pitch down vco1.pitch up lfo1.out
vco1.pitch down vco2.pitch up keys.pitch
vco2.pitch down vco3.pitch up vco1.pitch
vco3.pitch down noise.out up vco2.pitch
noise.out down mix.in1 up vco3.pitch
mix.in1 down vcf1.in up noise.out
vcf1.in down vcf2.in up mix.in1
vcf2.in down vca.in up vcf1.in
vca.in down out.in up vcf2.in
out.in down env1.gate up vca.in
env1.gate down env2.gate up out.in
env2.gate down lfo2.out up env1.gate
lfo2.out down lfo1.out up env2.gate

# Errors
$ bogus
! schematic: unknown command bogus
exit 2
