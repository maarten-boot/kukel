# Tests of lmwctl.kkl and so of the modules lmw and fakesynth, run in
# examples/lmw (see examples/README.md). -fake serves a fake synth in the
# program itself; the real synth is tried by hand (docs/future.md 13.8).

# Parameters: values as the synth writes them, choices by name, prefix, "dB"-less name or index, numbers clipped to the range and put on the step
$ -fake get vcf1.cutoff , get voice.count , get vcf1.slope , get vco1.octave , source
18000.0
8
24 dB
0
https://github.com/maarten-boot/software-synth-LMW

$ -fake set vcf1.cutoff 800 , get vcf1.cutoff , set vcf1.cutoff 99999 , get vcf1.cutoff , set vcf1.cutoff -3 , get vcf1.cutoff
800.0
18000.0
20.0

$ -fake set vcf1.type band , get vcf1.type , set vcf1.slope 12 , get vcf1.slope , set vco1.octave 1 , get vco1.octave , set lfo1.wave 3 , get lfo1.wave
Bandpass
12 dB
+1
Square

$ -fake set voice.count 7.6 , get voice.count , set vco1.tune 1.234 , get vco1.tune , set env1.attack 1e-3 , get env1.attack
8
1.23
0.001

$ -fake info vcf1.cutoff , info vcf1.type , info voice.count , info vco2.tune , info out.gain
vcf1.cutoff float 20.0..18000.0 [18000.0] unit Hz centre 600.0
vcf1.type choice Lowpass|Highpass|Bandpass|Notch [Lowpass]
voice.count int 1..32 [8]
vco2.tune float -7.0..7.0 [0.0] unit st step 0.01
out.gain float 0.0..1.0 [0.8] unit dB

$ -fake params
voice.count int 1..32 [8]
vco1.wave choice Sine|Saw|Square|Triangle [Saw]
vco1.octave choice -2|-1|0|+1|+2 [0]
vco1.tune float -7.0..7.0 [0.0] unit st step 0.01
