// schematic.kkl: prints what lmwgui's Schematic tab draws (module
// lmwschematic), for schematic.tests.
//
//     kukel run schematic.kkl -- ports | layout [block=x,y ...] | describe | jump
//
// ports: where each port is at the default layout (units). layout: the
// layout of a [schematic] section with those entries (as the synth reads
// it). describe: the hover texts and connections of a patch with a few
// cables. jump: the keyboard's port cursor, Up and Down from each block.
use lmwschematic;

// The synth's normalled sources (its /ports).
global NORMALLED = {
    "vco1.pitch": "keys.pitch", "vco1.fm": "lfo1.out", "vco2.pitch": "keys.pitch", "vco2.fm": "lfo1.out",
    "vco3.pitch": "keys.pitch", "vco3.fm": "lfo1.out", "env1.gate": "keys.gate", "env2.gate": "keys.gate",
    "mix.in1": "vco1.out", "mix.in2": "vco2.out", "mix.in3": "vco3.out", "mix.in4": "noise.out",
    "vcf1.in": "mix.out", "vcf1.cutoff": "env2.out", "vcf1.res": "none", "vcf2.in": "vcf1.out",
    "vcf2.cutoff": "env2.out", "vcf2.res": "none", "vca.in": "vcf2.out", "vca.cv": "env1.out",
    "vca.mod": "lfo2.out", "out.in": "vca.out",
};

_r(x) {
    return round(x * 10) / 10.0;
}

main(args) {
    if (len(args) < 1) {
        eprintln("usage: schematic ports | layout [block=x,y ...] | describe | jump");
        return 2;
    }

    if (args[0] == "ports") {
        local l = lmwschematic::defaults();

        for (local p in lmwschematic::order()) {
            local q = lmwschematic::point(l, p);
            println(p, lmwschematic::isinput(p) ? "in " : "out", _r(q[0]), _r(q[1]));
        }
    } else if (args[0] == "layout") {
        local section = {};

        for (local i = 1; i < len(args); i++) {
            local eq = find(args[i], "=");
            section[slice(args[i], 0, eq)] = slice(args[i], eq + 1);
        }
        local l = lmwschematic::layout(section), d = lmwschematic::defaults();
        println("moved", lmwschematic::moved(l));

        for (local b in lmwschematic::BLOCKS) {
            local id = lmwschematic::blockid(b["name"]);

            if (l[id][0] != d[id][0] || l[id][1] != d[id][1]) {
                println(id, l[id][0], l[id][1]);
            }
        }
        local p = lmwschematic::point(l, "vcf1.cutoff");
        println("vcf1.cutoff at", _r(p[0]), _r(p[1]));
    } else if (args[0] == "describe") {
        local cables = {"vcf1.cutoff": [["lfo1.out", 0.5], ["env2.out", 1.0]], "vca.mod": [["lfo1.out", 0.25]], "mix.in4": []};

        for (local input in ["vcf1.cutoff", "vca.mod", "vcf1.res", "mix.in4", "vco1.fm"]) {
            println(lmwschematic::describeinput(input, cables, NORMALLED));
        }

        for (local output in ["lfo1.out", "env2.out", "lfo2.out", "keys.vel"]) {
            println(lmwschematic::describeoutput(output, cables, NORMALLED));
        }

        for (local name in ["VCO 2", "VCF 1", "VCF 2", "VCA", "MIX"]) {
            println(name + ":", lmwschematic::blocknote(name, 0.5, 0.0));
        }

        for (local k in lmwschematic::links(0.5, 0.0)) {
            local i = lmwschematic::findblock(k["block"]), t = lmwschematic::target(lmwschematic::defaults(), i);
            println("link", k["from"], "→", k["block"], k["label"], "at", _r(t[0]), _r(t[1]));
        }
        local n = 0, dashed = 0;

        for (local c in lmwschematic::connections(cables, NORMALLED)) {
            n++;

            if (c["normalled"]) {
                dashed++;
            }
        }
        println("connections", n, "normalled", dashed);
        local l = lmwschematic::defaults();
        println("at 68,24.5:", lmwschematic::portat(l, 68, 24.5, 1.2), lmwschematic::portat(l, 68, 24.5, 1.2, "output"));
        println("at 100,27:", lmwschematic::portat(l, 100, 27, 1.2), "block", lmwschematic::BLOCKS[lmwschematic::blockat(l, 75, 27)]["name"]);
        local c = lmwschematic::curve(lmwschematic::point(l, "lfo1.out"), lmwschematic::point(l, "vcf1.cutoff"));
        local m = lmwschematic::at(c, 0.5);
        println("curve lfo1.out → vcf1.cutoff, middle", _r(m[0]), _r(m[1]), "pieces", len(lmwschematic::points(c, 16, 6.5)) / 2 - 1);
    } else if (args[0] == "jump") {
        local ports = lmwschematic::order(), k = 0;
        println(len(ports), "ports");

        for (local b in lmwschematic::BLOCKS) {
            local down = lmwschematic::jump(k, 1), up = lmwschematic::jump(k, -1);
            println(ports[k], "down", ports[down], "up", ports[up]);
            k = down;
        }
    } else {
        eprintln("schematic: unknown command", args[0]);
        return 2;
    }
    return 0;
}
