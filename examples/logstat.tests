# Tests of logstat.kkl, run in examples/ (see examples/README.md).
# testdata/app.log has a stack trace line after the entry of 09:05:00.

$ testdata/app.log
entries  16 (and 1 other line)
from     2026-10-16 08:58:40
to       2026-10-16 11:20:32  (2h 21m 52s)
levels
  INFO       8
  ERROR      4
  WARN       3
  DEBUG      1
hours
  2026-10-16 08:00   2  ##
  2026-10-16 09:00   7  #######
  2026-10-16 10:00   4  ####
  2026-10-16 11:00   3  ###
errors
  2026-10-16 09:02:30  could not write /var/data/cache.db: disk full
  2026-10-16 09:05:00  retrying write (attempt 2)
  2026-10-16 10:15:09  request failed: connection reset by peer
  2026-10-16 11:20:31  disk full

# The stack trace goes with its entry.
$ -since '2026-10-16 10:00' testdata/app.log
entries  7
from     2026-10-16 10:03:44
to       2026-10-16 11:20:32  (1h 16m 48s)
levels
  INFO       4
  ERROR      2
  WARN       1
hours
  2026-10-16 10:00   4  ####
  2026-10-16 11:00   3  ###
errors
  2026-10-16 10:15:09  request failed: connection reset by peer
  2026-10-16 11:20:31  disk full

# 11:02 in +02:00 is 09:02 UTC; standard input.
$ -since 2026-10-16T11:02:00+02:00 < testdata/log.txt
entries  4
from     2026-10-16 09:02:30
to       2026-10-16 09:05:02  (2m 32s)
levels
  ERROR      2
  INFO       2
hours
  2026-10-16 09:00   4  ####
errors
  2026-10-16 09:02:30  could not write /var/data/cache.db: disk full
  2026-10-16 09:05:00  retrying write (attempt 2)

# The last 30 minutes before the newest entry (11:20:32).
$ -last 30m -json testdata/app.log
{
  "entries": 3,
  "other": 0,
  "from": "2026-10-16 11:00:00",
  "to": "2026-10-16 11:20:32",
  "seconds": 1232,
  "levels": {
    "INFO": 2,
    "ERROR": 1
  },
  "hours": {
    "2026-10-16 11:00": 3
  },
  "errors": [
    {
      "time": "2026-10-16 11:20:31",
      "message": "disk full"
    }
  ]
}

$ -since 2027-01-01 testdata/app.log
entries  0

$ -json -since 2027-01-01 testdata/app.log
{
  "entries": 0,
  "other": 0,
  "from": null,
  "to": null,
  "seconds": 0,
  "levels": {},
  "hours": {},
  "errors": []
}

# A file that cannot be read: the others still count.
$ nosuch.log testdata/log.txt
entries  7
from     2026-10-16 09:00:01
to       2026-10-16 09:05:02  (5m 1s)
levels
  INFO       4
  ERROR      2
  WARN       1
hours
  2026-10-16 09:00   7  #######
errors
  2026-10-16 09:02:30  could not write /var/data/cache.db: disk full
  2026-10-16 09:05:00  retrying write (attempt 2)
! logstat: readfile: nosuch.log: no such file or directory
exit 1

$ -since tomorrow testdata/app.log
! logstat: -since: cannot read the time tomorrow
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

$ -since 2026-02-30 testdata/app.log
! logstat: -since: cannot read the time 2026-02-30
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

$ -since
! logstat: -since needs a value
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

$ -last 5w testdata/app.log
! logstat: -last: cannot read the duration 5w (such as 90s, 45m, 2h, 1d; at most 36500d)
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

# Too long: more than 36500 days, or too many digits for an int.
$ -last 36501d testdata/app.log
! logstat: -last: cannot read the duration 36501d (such as 90s, 45m, 2h, 1d; at most 36500d)
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

$ -last 99999999999999999999d testdata/app.log
! logstat: -last: cannot read the duration 99999999999999999999d (such as 90s, 45m, 2h, 1d; at most 36500d)
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

$ -since 2026-10-16 -last 1h testdata/app.log
! logstat: give -since or -last, not both
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2

$ -x testdata/app.log
! logstat: unknown option -x
! usage: logstat [-since TIME | -last DURATION] [-json] [file ...]
exit 2
