{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kukel",
  "scopeName": "source.kukel",
  "fileTypes": [
    "kkl"
  ],
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#this"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#qualified"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.kukel",
      "match": "\\A#!.*$"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.kukel",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.kukel",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.kukel",
          "match": "#.*$"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.kukel",
          "match": "\\\\(?:[ntr0\\\\\\\"']|x[0-9A-Fa-f]{1,2})"
        },
        {
          "name": "invalid.illegal.escape.kukel",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kukel",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.kukel",
      "match": "'(?:[^'\\\\]|\\\\(?:[ntr0\\\\\\\"']|x[0-9A-Fa-f]{1,2}))'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kukel",
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.binary.kukel",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.float.kukel",
          "comment": "1.5, 1., .5, 2e10, 1_000.5e1_0 (not the 1 of 1..)",
          "match": "(?:\\b[0-9](?:_?[0-9])*\\.(?!\\.)(?:[0-9](?:_?[0-9])*)?|(?<![A-Za-z0-9_.])\\.[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?![A-Za-z0-9_])|\\b[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "constant.numeric.integer.kukel",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.kukel"
            },
            "2": {
              "name": "entity.name.type.class.kukel"
            }
          }
        },
        {
          "match": "\\b(new)\\s+((?:[A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.new.kukel"
            },
            "2": {
              "name": "entity.name.type.class.kukel"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "a definition: name(...) { at the start of a line, also C::m(...) {",
          "match": "^((?:[A-Za-z_][A-Za-z0-9_]*::)*[A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\([^)]*\\)\\s*\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.kukel"
            }
          }
        },
        {
          "comment": "a call",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.kukel"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kukel",
          "match": "\\b(?:break|case|catch|continue|default|do|else|finally|for|if|in|return|switch|throw|try|while|with)\\b"
        },
        {
          "name": "storage.type.kukel",
          "match": "\\b(?:class|const|fn|global|local|new|static|use)\\b"
        },
        {
          "name": "constant.language.kukel",
          "match": "\\b(?:true|false|nil)\\b"
        }
      ]
    },
    "this": {
      "name": "variable.language.this.kukel",
      "match": "\\bthis\\b"
    },
    "builtins": {
      "name": "support.function.builtin.kukel",
      "match": "\\b(?:abs|appendfile|atan2|ceil|char|classof|clock|cos|delete|eprint|eprintln|exit|exp|find|float|floor|getenv|haskey|insert|instanceof|int|join|keys|len|log|lower|max|min|ord|pop|pow|print|println|push|randint|random|readfile|readline|remove|replace|round|seed|sin|slice|sort|split|sqrt|str|tan|time|trim|typeof|upper|values|writefile)\\b(?=\\s*\\()"
    },
    "qualified": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.kukel"
        },
        "2": {
          "name": "punctuation.separator.namespace.kukel"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kukel",
          "match": "->"
        },
        {
          "name": "keyword.operator.spread.kukel",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.kukel",
          "match": "(?:<<|>>|[-+*/%&|^])?=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.kukel",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.kukel",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.kukel",
          "match": "\\+\\+|--|<<|>>|[-+*/%&|^~?:]"
        }
      ]
    }
  }
}
