// Native module zmq: ZeroMQ sockets. A worker plays the server; inproc://
// endpoints connect interpreters of one process (tcp:// works the same
// between processes and machines).
use zmq;
use worker;
use events;
use time;

// Answers requests until it gets "stop".
server() {
    local rep = new zmq::Socket("REP");
    rep->bind("inproc://calc");
    worker::send("ready");

    for (local req = rep->receive(); req != "stop"; req = rep->receive()) {
        if (typeof(req) == "vector")                  // a message of several parts
            rep->send(["sum", str(int(req[0]) + int(req[1]))]);
        else
            rep->send("echo: " + req);
    }
    rep->send("stopped");
    rep->close();
}

main() {
    // Request and reply.
    local w = worker::start(server);
    w->receive();                                     // the server is bound
    local req = new zmq::Socket("REQ");
    req->connect("inproc://calc");
    println(req);
    req->send("hello");
    println(req->receive(5));
    req->send(["40", "2"]);
    println(req->receive(5));
    req->send("stop");
    println(req->receive(5));
    req->close();
    w->wait();

    // Push and pull, through the event loop.
    local pull = new zmq::Socket("PULL"), push = new zmq::Socket("PUSH"), done = 0;
    pull->bind("inproc://jobs");
    push->connect("inproc://jobs");
    println(pull->receive(0.05));                     // nothing yet: nil
    pull->onmessage(fn(job) {
        println("job", job);

        if (++done == 3) pull->close();               // closing ends events::run()
    });

    for (local i = 1; i <= 3; i++) push->send(str(i));
    events::run();
    push->close();
    println(pull);

    // A ROUTER talks to many peers: each message starts with the identity
    // of the peer it comes from, and a reply starting with it goes back there.
    local router = new zmq::Socket("ROUTER");
    router->bind("inproc://hub");
    local alice = new zmq::Socket("DEALER", "alice"), bob = new zmq::Socket("DEALER", "bob");
    alice->connect("inproc://hub");
    bob->connect("inproc://hub");
    time::sleep(0.05);                                // let both connect
    alice->send("hi from alice");
    bob->send("hi from bob");

    for (local i = 0; i < 2; i++) {
        local m = router->receive(5);                 // [identity, text]
        router->send([m[0], "welcome, " + m[0]]);
    }
    println(alice->receive(5), "|", bob->receive(5));

    // poll waits for whichever socket has a message first.
    local news = new zmq::Socket("PULL"), alerts = new zmq::Socket("PULL");
    news->bind("inproc://news");
    alerts->bind("inproc://alerts");
    local feed = new zmq::Socket("PUSH");
    feed->connect("inproc://alerts");
    println(zmq::poll([news, alerts], 0.05));        // nothing yet: nil
    feed->send("storm warning");
    local s = zmq::poll([news, alerts], 5);
    println(s == alerts, s->receive());               // the message is already there

    for (local x in [router, alice, bob, news, alerts, feed]) x->close();

    try {
        new zmq::Socket("STREAM");
    } catch (e) {
        println(e->kind + ":", e->message);
    }
}
