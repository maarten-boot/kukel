// Named arguments (syntax version 11): an argument given by the name of its
// parameter, after the positional ones, in calls whose function the
// compiler knows.

use iter;

global calls = 0;

area(w, h = w) {
    return w * h;
}

box(width, height, depth = 1, label = "box") {
    return [width, height, depth, label];
}

count() {
    calls++;
    return calls;
}

// The default of n runs only when n is missing: count() is not called
// for an argument given by name.
tick(start, n = count(), step = 1) {
    return [start, n, step];
}

trace(x, tag) {
    print(tag, "");
    return x;
}

// A default that captures a parameter in a function literal, and a
// parameter that the body captures.
adder(base, add = fn(x) { return x + base; }, scale = 1) {
    local scaled = fn(x) { return add(x) * scale; };
    return scaled;
}

countdown(n, step = 1, last = 0) {
    for (local i = n; i > last; i -= step) {
        yield i;
    }
}

need(name) {
    throw new Error("no " + name, "ValueError");
}

fails(x, y = need("y"), z = 0) {
    return [x, y, z];
}

class Shape {
    name, sides;
    Shape(name, sides);
    describe(prefix, suffix);
    static make(sides, name);
}

Shape::Shape(name, sides = 0) {
    this->name = name;
    this->sides = sides;
}

Shape::describe(prefix = "", suffix = "") {
    return prefix + name + "/" + str(sides) + suffix;
}

Shape::make(sides, name = "polygon") {
    return new Shape(sides: sides, name: name);
}

class Square : Shape {
    side;
    Square(side);
    describe(prefix, suffix);
}

Square::Square(side) {
    Shape::Shape(sides: 4, name: "square");
    this->side = side;
}

Square::describe(prefix = "", suffix = "") {
    return Shape::describe(suffix: " side " + str(side) + suffix);
}

main() {
    println(area(h: 4, w: 3), area(w: 5), area(2, h: 7));
    println(box(10, 20, label: "crate"), box(1, 2, depth: 3));
    println(
        box(
            height: 2,
            width: 1,
            label: "x",
            depth: 4,
        ),
    );

    // Arguments are evaluated as they are written.
    println(box(label: trace("L", "a"), width: trace(1, "b"), height: trace(2, "c")));

    println(tick(0, step: 5), calls);
    println(tick(0, n: 9, step: 5), calls);
    println(tick(start: 1), calls);

    // nil given by name is nil, not a missing argument.
    println(
        box(
            1,
            2,
            depth: nil,
            label: nil,
        ),
    );

    println(adder(10, scale: 2)(1), adder(base: 1, add: fn(x) { return -x; })(5));

    local v = [];

    for (local i in countdown(10, last: 4)) {
        push(v, i);
    }
    println(v, iter::collect(countdown(step: 3, n: 9)));

    println(iter::collect(iter::range(0, 10, step: 4)), iter::collect(iter::range(3, step: 1)));

    try {
        fails(1, z: 2);
    } catch (e) {
        println(e->kind, e->message);
    }
    println(fails(1, y: 2), fails(z: 3, y: 2, x: 1));

    local s = new Shape(sides: 3, name: "triangle");
    println(s->describe(), new Shape(name: "dot")->describe());
    println(Shape::make(5)->describe(), Shape::make(name: "hexagon", sides: 6)->describe());
    println(new Square(2)->describe());

    // A call of itself by name.
    println(area(area(w: 2), h: area(w: 1, h: 3)));
}
