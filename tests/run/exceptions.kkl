// Try/catch/finally, throw, Error objects and Error classes.

class ConfigError : Error {
    key;
    ConfigError(key, message);
}
ConfigError::ConfigError(key, message) {
    Error::Error(message);
    this->key = key;
}

global config = {"port": "8080", "debug": "yes", "retries": "x"};

getInt(key) {
    if (!haskey(config, key)) throw new ConfigError(key, "missing");
    local text = config[key], value = 0;

    for (local c in text) {
        local digit = c - '0';

        if (digit < 0 || digit > 9) throw new ConfigError(key, "not a number: " + text);
        value = value * 10 + digit;
    }
    return value;
}

withLog(name, action) {
    println("start", name);

    try {
        return action();
    } finally {
        println("end", name);
    }
}

port() { return getInt("port"); }
retries() { return getInt("retries"); }
crash() { return [1, 2, 3][10]; }

main() {
    for (local job in [port, retries, crash]) {
        try {
            println("result:", withLog(str(job), job));
        } catch (e) {
            if (instanceof(e, ConfigError)) println("config problem with", e->key + ":", e->message);
            else println("other problem:", e->kind, e->message, "at", e->trace[0]);
        }
    }

    try { getInt("timeout"); } catch (e) { println(e->kind, e->key, e->message); }
}
