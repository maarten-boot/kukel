// "x += e" as a statement, x a local, is one instruction (ADD_LOCAL) when e
// assigns nothing; the results are those of x = x + e in every case.
main() {
    local x = 1, s = "a", f = 1.5, v = [1];
    x += 2; x += x; s += "b"; s += str(x); f += 1;
    local y = 10;
    y += (y = 1);            // reads y before the assignment: 10 + 1
    local z = 5; z += z++;   // 5 + 5
    println(x, s, f, y, z);
    try { v += 1; } catch (e) { println(e->kind + ":", e->message); }
    try { local q = nil; q += 1; } catch (e) { println(e->kind + ":", e->message); }
}
