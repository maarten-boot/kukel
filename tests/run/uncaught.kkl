// An Error nobody catches stops the program: message, kind and trace.

// It inherits Error's constructor: new ValidationError("...") sets message.
class ValidationError : Error {}

check(age) {
    if (age < 0) throw new ValidationError("age must not be negative");
    return age;
}

main() {
    println(check(30));

    try {
        check(-1);
    } finally {
        println("finally runs before the program stops");
    }
}
