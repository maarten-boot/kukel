// FizzBuzz: numbers, with Fizz for multiples of 3, Buzz for 5, FizzBuzz for both.

fizzbuzz(n) {
    if (n % 15 == 0) return "FizzBuzz";
    else if (n % 3 == 0) return "Fizz";
    else if (n % 5 == 0) return "Buzz";
    return n;
}

main() {
    for (local i = 1; i <= 20; i++)
        println(fizzbuzz(i));
}
