// Run by TestServers on SQLite and on the servers KUKEL_TEST_POSTGRES and
// KUKEL_TEST_MYSQL name: every database must print the same.
use db;
use time;

class Item {
    id, name, price, instock, added;
    static columns();
}

Item::columns() {
    return {"name": "VARCHAR(100) NOT NULL", "price": "DOUBLE PRECISION", "instock": "BOOLEAN", "added": "TIMESTAMP"};
}

class Customer { id, name, orders; static relations(); static columns(); }
Customer::columns() { return {"name": "VARCHAR(20)"}; }
Customer::relations() { return {"orders": db::many(Order, "customerid")}; }

class Order { id, customerid, day, customer, lines; static relations(); static columns(); }
Order::relations() {
    return {"customer": db::one(Customer, "customerid"), "lines": db::many(Line, "orderid")};
}
Order::columns() { return {"customerid": "BIGINT", "day": "VARCHAR(10)"}; }

class Line { id, orderid, product, qty; static columns(); }
Line::columns() { return {"orderid": "BIGINT", "product": "VARCHAR(20)", "qty": "INTEGER"}; }

class Tag { id, label; static columns(); }
Tag::columns() { return {"id": "VARCHAR(40) PRIMARY KEY", "label": "TEXT"}; }

main(args) {
    local conn = db::open(args[0]);

    for (local t in ["item", "tag", "plain", "line", "order", "customer"]) conn->exec("DROP TABLE IF EXISTS " + quoted(args[0], t));

    // plain SQL: parameters, types, a ? inside a string, transactions
    conn->exec("CREATE TABLE plain (id INTEGER PRIMARY KEY, word VARCHAR(20) UNIQUE, n INTEGER, x DOUBLE PRECISION, ok BOOLEAN)");
    println(conn->exec("INSERT INTO plain (id, word, n, x, ok) VALUES (?, ?, ?, ?, ?), (?, ?, ?, ?, ?)", 1, "one?", 1, 1.5, true, 2, "two", 2, 2.5, false));
    println(conn->query("SELECT word, n, x FROM plain WHERE word <> '?' AND n >= ? ORDER BY id", 1));
    println(conn->first("SELECT COUNT(*) AS c, SUM(x) AS s FROM plain"));
    println(conn->first("SELECT 7 AS seven, 'a?b' AS text"));

    try { conn->exec("INSERT INTO plain (id, word) VALUES (?, ?)", 3, "one?"); } catch (e) { println(e->kind); }
    conn->begin();
    conn->exec("DELETE FROM plain");
    conn->rollback();
    println(conn->first("SELECT COUNT(*) AS c FROM plain"));
    local cu = conn->cursor("SELECT word FROM plain ORDER BY id");

    for (local r = cu->next(); r != nil; r = cu->next()) print(r["word"], "");
    println();

    // objects
    conn->migrate(Item);
    conn->migrate(Item);
    conn->migrate(Tag);
    local pen = new Item();
    pen->name = "pen"; pen->price = 1.5; pen->instock = true;
    pen->added = new time::Time(2026, 10, 15, 9, 30, 0);
    conn->save(pen);
    println("saved", pen->id);
    pen->price = 1.75;
    conn->save(pen);

    for (local n in ["ink", "paper", "clip"]) {
        local i = new Item();
        i->name = n; i->price = len(n) * 1.0; i->instock = n != "ink";
        conn->save(i);
    }

    local q = conn->find(Item)->where("price < ?", 5)->orderby("name");
    println(q->count());

    for (local i in q->all()) println(i->id, i->name, i->price, i->instock);
    local g = conn->get(Item, pen->id);
    println(g->name, g->price, g->instock, g->added);
    println(conn->find(Item)->orderby("price DESC")->limit(2, 1)->all());
    println(conn->delete(pen), conn->delete(pen), conn->find(Item)->count());
    println(conn->find(Item)->where("price > ?", 4)->delete(), conn->find(Item)->count());
    local t = new Tag();
    t->id = "urgent"; t->label = "Urgent!";
    conn->save(t);
    t->label = "URGENT";
    conn->save(t);
    println(conn->find(Tag)->all());
    // a save by id that breaks another unique key: an error, never a change
    // of the other row
    local clash = new Item();
    clash->id = 99; clash->name = "x"; clash->price = 3.0;       // ink has that price
    conn->exec("CREATE UNIQUE INDEX item_price ON item (price)");

    try { conn->save(clash); } catch (e) { println(e->kind); }
    println(conn->find(Item)->where("price = ?", 3.0)->all());

    // relations
    for (local c in [Customer, Order, Line]) conn->migrate(c);
    local ann = new Customer(), bob = new Customer();
    ann->name = "Ann"; conn->save(ann);
    bob->name = "Bob"; conn->save(bob);

    for (local spec in [[ann, "mon", ["pen", 2, "ink", 1]], [ann, "tue", ["paper", 5]], [bob, "wed", []]]) {
        local o = new Order();
        o->customerid = spec[0]->id; o->day = spec[1];
        conn->save(o);

        for (local i = 0; i < len(spec[2]); i += 2) {
            local l = new Line();
            l->orderid = o->id; l->product = spec[2][i]; l->qty = spec[2][i + 1];
            conn->save(l);
        }
    }

    local o = conn->load(conn->get(Order, 1), "customer", "lines");
    println(o->customer->name, len(o->lines), o->lines[0]->product, o->lines[1]->qty);

    for (local x in conn->find(Order)->include("customer", "lines")->orderby("id")->all())
        println(x->day, x->customer->name, len(x->lines));
    local c = conn->find(Customer)->include("orders")->where("name = ?", "Ann")->first();
    println(c->name, len(c->orders), c->orders[1]->day);
    conn->close();
}

// quoted quotes a table name for DROP TABLE: "order" is a keyword.
quoted(url, name) { return find(url, "mysql:") == 0 ? "`" + name + "`" : "\"" + name + "\""; }
